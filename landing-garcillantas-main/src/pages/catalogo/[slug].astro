---
import Layout from '../../layouts/Layout.astro';
import WhatsAppBtnPopup from '@/components/WhatsAppBtnPopup.astro';
import MarkdownRenderer from '@/components/MarkdownRenderer.astro';
import ExpandableContent from '@/components/ExpandableContent.astro';
import { getAllProducts, getProductBySlug, type Product } from '@/lib/contentful';
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import '../../styles/globals.css';

export async function getStaticPaths() {
  const products = await getAllProducts();

  return products.map((product: Product) => ({
    params: { slug: product.fields.slug },
  }));
}

const { slug } = Astro.params;
const product = await getProductBySlug(slug as string);

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}

const title = `${product.fields.productName} | Catálogo Garcillantas`;
const brandLabel = Array.isArray(product.fields.brand)
  ? product.fields.brand.join(', ')
  : product.fields.brand;
const categoryLabel = Array.isArray(product.fields.category)
  ? product.fields.category.join(', ')
  : product.fields.category;

const description = product.fields.notes ?? `${brandLabel} ${product.fields.model} (${categoryLabel})`;

const variants = product.fields.variants ?? [];
const prices = variants.map(v => v.fields.price).filter((p): p is number => typeof p === 'number');
const minPrice = prices.length ? Math.min(...prices) : null;
const maxPrice = prices.length ? Math.max(...prices) : null;


// Generate optimized image URLs
const mainImage = Array.isArray(product.fields.mainImage) ? product.fields.mainImage[0] : product.fields.mainImage;
const baseImageUrl = mainImage?.fields.file.url;
const imageUrl = baseImageUrl ? (baseImageUrl.startsWith('//') ? `https:${baseImageUrl}` : baseImageUrl) : '';
const imageUrlLarge = imageUrl ? `${imageUrl}?w=800&h=600&fit=pad` : '';
const imageUrlMedium = imageUrl ? `${imageUrl}?w=600&h=450&fit=pad` : '';

// Calculate stock and availability
const totalStock = variants.reduce((sum, v) => sum + (v.fields.stock || 0), 0);
const availableVariants = variants.filter(v => v.fields.stock > 0).length;

// Extract unique specifications
const rims = Array.from(new Set(variants.map(v => v.fields.rimSize).filter(Boolean))).sort((a, b) => a - b);
const widths = Array.from(new Set(variants.map(v => v.fields.width).filter(Boolean))).sort((a, b) => a - b);
const types = Array.from(new Set(variants.flatMap(v => 
  Array.isArray(v.fields.tireType) ? v.fields.tireType : (v.fields.tireType ? [v.fields.tireType] : [])
)));
const seasons = Array.from(new Set(variants.flatMap(v => 
  Array.isArray(v.fields.seasonUsage) ? v.fields.seasonUsage : (v.fields.seasonUsage ? [v.fields.seasonUsage] : [])
)));
---

<Layout title={title} description={description}>
  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb" aria-label="Navegación">
    <div class="breadcrumb-container">
      <a href="/" class="breadcrumb-link">Inicio</a>
      <span class="breadcrumb-separator">›</span>
      <a href="/catalogo" class="breadcrumb-link">Catálogo</a>
      <span class="breadcrumb-separator">›</span>
      <span class="breadcrumb-current">{product.fields.productName}</span>
    </div>
  </nav>

  <section class="product-section">
    <div class="product-wrapper">
      <!-- Product Hero Section -->
      <div class="product-hero">
        <div class="image-gallery">
          {imageUrl ? (
            <div class="main-image">
              <picture>
                <source media="(max-width: 768px)" srcset={imageUrlMedium} type="image/webp" />
                <img
                  src={imageUrlLarge}
                  alt={product.fields.productName}
                  loading="eager"
                  class="product-image"
                />
              </picture>
              
              {product.fields.isFeatured && (
                <span class="featured-badge">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  Destacado
                </span>
              )}
            </div>
          ) : (
            <div class="image-placeholder">
              <svg width="120" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21,15 16,10 5,21"/>
              </svg>
              <span>Imagen no disponible</span>
            </div>
          )}

          {product.fields.description && (
            <div class="product-description">
              <h1>Descripción de la llanta</h1>
              <ExpandableContent 
                maxHeight={250}
                className="description-expandable"
                buttonText={{
                  more: "Leer más",
                  less: "Leer menos"
                }}
              >
                <MarkdownRenderer 
                  content={product.fields.description} 
                  className="description-content"
                  sanitize={true}
                />
              </ExpandableContent>
            </div>
          )}
        </div>

        <div class="product-info">
          <div class="product-header">
            <div class="product-meta">
              <span class="brand-badge">{brandLabel}</span>
              <span class="category-badge">{categoryLabel}</span>
            </div>
            
            <h1 class="product-title">{product.fields.productName}</h1>
            <p class="product-model">Modelo: {product.fields.model}</p>
            
            <div class="availability-status">
              <div class={`stock-indicator ${totalStock > 5 ? 'in-stock' : totalStock > 0 ? 'low-stock' : 'out-of-stock'}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  {totalStock > 0 ? (
                    <path d="M20 6L9 17l-5-5"/>
                  ) : (
                    <circle cx="12" cy="12" r="10"/>
                  )}
                </svg>
                <span>
                  {totalStock > 5 ? 'En stock' : totalStock > 0 ? `${totalStock} unidades disponibles` : 'Sin stock'}
                </span>
              </div>
              
              <div class="variants-summary">
                <span>{availableVariants} de {variants.length} variantes disponibles</span>
              </div>
            </div>
          </div>

          {minPrice !== null && minPrice > 0 && (
            <div class="pricing-section">
              <div class="price-display">
                {maxPrice && maxPrice !== minPrice ? (
                  <div class="price-range">
                    <span class="price-from">Desde</span>
                    <span class="price-amount">${minPrice.toLocaleString('es-CO')}</span>
                    <span class="price-to">hasta ${maxPrice.toLocaleString('es-CO')}</span>
                  </div>
                ) : (
                  <div class="price-single">
                    <span class="price-amount">${minPrice.toLocaleString('es-CO')}</span>
                  </div>
                )}
              </div>
            </div>
          )}

          <div class="specifications-preview">
            <h3>Especificaciones disponibles</h3>
            <div class="specs-grid">
              {rims.length > 0 && (
                <div class="spec-item">
                  <span class="spec-label">Rines:</span>
                  <span class="spec-value">{rims.join('", ')}"</span>
                </div>
              )}
              {widths.length > 0 && (
                <div class="spec-item">
                  <span class="spec-label">Anchos:</span>
                  <span class="spec-value">{widths.join(', ')}</span>
                </div>
              )}
              {types.length > 0 && (
                <div class="spec-item">
                  <span class="spec-label">Tipos:</span>
                  <span class="spec-value">{types.slice(0, 3).join(', ')}{types.length > 3 ? '...' : ''}</span>
                </div>
              )}
              {seasons.length > 0 && (
                <div class="spec-item">
                  <span class="spec-label">Temporadas:</span>
                  <span class="spec-value">{seasons.join(', ')}</span>
                </div>
              )}
            </div>
          </div>

          <div class="action-buttons">
            <WhatsAppBtnPopup 
              text="Consultar disponibilidad"
              message={`Hola, me interesa el producto: ${product.fields.productName} (${brandLabel} ${product.fields.model}). ¿Podrían darme más información sobre disponibilidad y precios?`}
              variant="primary"
              popupId="product-whatsapp"
            />
            
            {Array.isArray(product.fields.technicalSheet) && product.fields.technicalSheet[0] && (
              <a
                href={product.fields.technicalSheet[0].fields.file.url}
                target="_blank"
                rel="noopener noreferrer"
                class="technical-sheet-btn"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10,9 9,9 8,9"/>
                </svg>
                Ficha técnica PDF
              </a>
            )}
          </div>
          
        </div>
      </div>

      <div class="variants-section">
        <h2>Dimensiones Disponibles</h2>
        {variants.length === 0 && <p>No hay dimensiones disponibles para este producto.</p>}

        {variants.length > 0 && (
          <div class="variants-table-wrapper">
            <table class="variants-table">
              <thead>
                <tr>
                  <th>Ancho</th>
                  <th>Perfil</th>
                  <th>Rin</th>
                  <th>Índice carga/velocidad</th>
                  <th>Tipo</th>
                  <th>Uso/temporada</th>
                  <th>Precio</th>
                  <th>Stock</th>
                  <th>Ficha técnica</th>
                  <th>Consultar</th>
                </tr>
              </thead>
              <tbody>
                {variants.map(variant => (
                  <tr>
                    <td>{variant.fields.width}</td>
                    <td>{variant.fields.aspectRatio}</td>
                    <td>{variant.fields.rimSize}</td>
                    <td>{variant.fields.loadspeedIndex}</td>
                    <td>
                      {Array.isArray(variant.fields.tireType)
                        ? variant.fields.tireType.join(', ')
                        : variant.fields.tireType}
                    </td>
                    <td>
                      {Array.isArray(variant.fields.seasonUsage)
                        ? variant.fields.seasonUsage.join(', ')
                        : variant.fields.seasonUsage}
                    </td>
                    <td>
                      {variant.fields.price && variant.fields.price > 0 ? (
                        `$${variant.fields.price.toLocaleString('es-CO')}`
                      ) : (
                        <span class="no-price">Consultar precio</span>
                      )}
                    </td>
                    <td>{variant.fields.stock}</td>
                    <td>
                      {variant.fields.variantTechnicalSheet ? (
                        <a
                          href={variant.fields.variantTechnicalSheet.fields.file.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="Ver ficha técnica en PDF"
                          class="variant-pdf-link"
                        >
                          <span class="variant-pdf-inner">
                            <img
                              src="/icons/pdf.svg"
                              alt="PDF"
                              class="variant-pdf-icon"
                              loading="lazy"
                            />
                            <span class="variant-pdf-text">Ficha PDF</span>
                          </span>
                        </a>
                      ) : (
                        <span class="no-technical-sheet">—</span>
                      )}
                    </td>
                    <td>
                      <WhatsAppBtnPopup
                        text="Consultar"
                        message={`Hola, me interesa el producto: ${product.fields.productName} (${brandLabel} ${product.fields.model}) - Medida: ${variant.fields.width}/${variant.fields.aspectRatio}R${variant.fields.rimSize}. ¿Podrían darme más información sobre disponibilidad y precio?`}
                        variant="primary"
                        popupId={`variant-whatsapp-${variant.fields.width}-${variant.fields.aspectRatio}-${variant.fields.rimSize}`}
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  :root {
    --primary-color: #0d4ba0;
    --secondary-color: #ffdd00;
    --max-width: 1200px;
    --success-color: #059669;
    --warning-color: #d97706;
    --error-color: #dc2626;
  }

  /* Breadcrumb Navigation */
  .breadcrumb {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 0;
  }

  .breadcrumb-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .breadcrumb-link {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-link:hover {
    color: #1e40af;
  }

  .breadcrumb-separator {
    color: #9ca3af;
  }

  .breadcrumb-current {
    color: #6b7280;
    font-weight: 500;
  }

  /* Product Section */
  .product-section {
    padding: 2rem 0;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    min-height: 80vh;
  }

  .product-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Product Hero */
  .product-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
    background: white;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .image-gallery {
    position: relative;
  }

  .main-image {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    gap: 1rem;
  }

  .image-placeholder span {
    font-size: 1rem;
    font-weight: 500;
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: linear-gradient(135deg, #1f2937, #374151);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  /* Product Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .brand-badge,
  .category-badge {
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brand-badge {
    background: var(--primary-color);
    color: white;
  }

  .category-badge {
    background: #f3f4f6;
    color: #374151;
  }

  .product-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #111827;
    margin: 0;
    line-height: 1.2;
  }

  .product-model {
    font-size: 1.125rem;
    color: #6b7280;
    margin: 0;
  }

  .availability-status {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
  }

  .stock-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .stock-indicator.in-stock {
    color: #16a34a !important;
  }

  .stock-indicator.in-stock svg {
    stroke: #16a34a !important;
  }

  .stock-indicator.low-stock {
    color: #d97706 !important;
  }

  .stock-indicator.low-stock svg {
    stroke: #d97706 !important;
  }

  .stock-indicator.out-of-stock {
    color: #dc2626 !important;
  }

  .stock-indicator.out-of-stock svg {
    stroke: #dc2626 !important;
  }

  .variants-summary {
    font-size: 0.875rem;
    color: #6b7280;
  }

  /* Pricing */
  .pricing-section {
    padding: 1.5rem;
    background: linear-gradient(135deg, var(--primary-color), #1e40af);
    border-radius: 1rem;
    color: white;
  }

  .price-display {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-amount {
    font-size: 2rem;
    font-weight: 700;
  }

  .price-from,
  .price-to {
    font-size: 1rem;
    opacity: 0.9;
  }

  /* Specifications Preview */
  .specifications-preview {
    background: #f8fafc;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
  }

  .specifications-preview h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1rem 0;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .spec-item:last-child {
    border-bottom: none;
  }

  .spec-label {
    font-weight: 500;
    color: #374151;
    font-size: 0.875rem;
  }

  .spec-value {
    font-weight: 600;
    color: #111827;
    font-size: 0.875rem;
    text-align: right;
  }

  /* Action Buttons */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .technical-sheet-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: white;
    border: 2px solid var(--primary-color);
    color: var(--primary-color);
    text-decoration: none;
    border-radius: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .technical-sheet-btn:hover {
    background: var(--primary-color);
    color: white;
  }

  /* Product Description */
  .product-description {
    background: white;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
  }

  .product-description h1 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827 !important;
    margin: 0 0 1rem 0;
  }

  .product-description h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 1rem 0;
  }

  .description-content {
    font-size: 1rem;
    line-height: 1.6;
    color: #111827 !important;
  }

  /* Ensure all text in description is black */
  .product-description * {
    color: #111827 !important;
  }

  .product-description .description-content * {
    color: #111827 !important;
  }

  /* Variants Section */
  .variants-section {
    background: white;
    padding: 2rem;
    border-radius: 1.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .variants-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 1.5rem 0;
  }

  .variants-table-wrapper {
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
  }

  .variants-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    background: white;
  }

  .variants-table th {
    background: #f8fafc;
    padding: 1rem 0.75rem;
    text-align: left;
    font-weight: 600;
    color: #111827 !important;
    border-bottom: 1px solid #e2e8f0;
  }

  .variants-table td {
    padding: 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    color: #111827 !important;
  }

  .variants-table tbody tr:hover {
    background: #f8fafc;
  }

  /* Ensure all text in variants section is black */
  .variants-section * {
    color: #111827 !important;
  }

  .variants-table * {
    color: #111827 !important;
  }

  .variant-pdf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    background: #fef2f2;
    color: #dc2626 !important;
    text-decoration: none;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .variant-pdf-link * {
    color: #dc2626 !important;
  }

  .variant-pdf-link:hover {
    background: #fecaca;
    transform: translateY(-1px);
  }

  .no-price {
    color: #6b7280 !important;
    font-style: italic;
    font-size: 0.875rem;
  }

  .no-technical-sheet {
    color: #9ca3af !important;
    font-size: 1rem;
    text-align: center;
    display: block;
    width: 100%;
  }

  .variants-table td:last-child {
    text-align: center;
  }

  .variants-table td:last-child .whatsapp-container .whatsapp-btn {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .specs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .product-hero {
      padding: 1.5rem;
    }

    .variants-section {
      padding: 1.5rem;
    }

    .action-buttons {
      flex-direction: column;
    }

    .breadcrumb-container {
      padding: 0 0.5rem;
    }
  }
</style>

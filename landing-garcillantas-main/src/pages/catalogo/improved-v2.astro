---
import Layout from '../../layouts/Layout.astro';
import CatalogLayout from '@/components/catalog/CatalogLayout.astro';
import { getAllProducts, type Product } from '@/lib/contentful';

const title = 'Catálogo de Productos | Garcillantas';
const description = 'Explora nuestro catálogo completo de llantas con filtros avanzados, búsqueda inteligente y comparación de productos. Encuentra la llanta perfecta para tu vehículo.';

// Fetch products from Contentful
const products = await getAllProducts();

// Extract filter options from products
const allBrands = Array.from(new Set(
  products.flatMap((p: Product) => Array.isArray(p.fields.brand) ? p.fields.brand : [p.fields.brand])
)).filter(Boolean).sort();

const allRims = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? []).map(v => v.fields.rimSize))
)).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);

const allWidths = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? []).map(v => v.fields.width))
)).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);

const allTypes = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? [])
    .flatMap(v => Array.isArray(v.fields.tireType) ? v.fields.tireType : (v.fields.tireType ? [v.fields.tireType] : [])))
)).filter(Boolean).sort();

const allSeasons = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? [])
    .flatMap(v => Array.isArray(v.fields.seasonUsage) ? v.fields.seasonUsage : (v.fields.seasonUsage ? [v.fields.seasonUsage] : [])))
)).filter(Boolean).sort();

// SEO and structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `${Astro.site}catalogo/`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": products.length,
    "itemListElement": products.slice(0, 10).map((product: Product, index: number) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Product",
        "name": product.fields.productName,
        "brand": Array.isArray(product.fields.brand) ? product.fields.brand[0] : product.fields.brand,
        "model": product.fields.model,
        "category": Array.isArray(product.fields.category) ? product.fields.category.join(", ") : product.fields.category,
        "url": `${Astro.site}catalogo/${product.fields.slug}/`,
        "image": product.fields.mainImage?.[0]?.fields.file.url ? 
          `https:${product.fields.mainImage[0].fields.file.url}` : undefined,
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "COP",
          "availability": "https://schema.org/InStock"
        }
      }
    }))
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": `${Astro.site}`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Catálogo",
        "item": `${Astro.site}catalogo/`
      }
    ]
  }
};
---

<Layout title={title} description={description}>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content={title} slot="head" />
  <meta property="og:description" content={description} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${Astro.site}catalogo/`} slot="head" />
  <meta property="og:image" content={`${Astro.site}images/catalog-og-image.jpg`} slot="head" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={title} slot="head" />
  <meta name="twitter:description" content={description} slot="head" />
  <meta name="twitter:image" content={`${Astro.site}images/catalog-og-image.jpg`} slot="head" />
  
  <!-- Additional Meta Tags -->
  <meta name="robots" content="index, follow" slot="head" />
  <meta name="googlebot" content="index, follow" slot="head" />
  <link rel="canonical" href={`${Astro.site}catalogo/`} slot="head" />
  
  <!-- Preload critical resources -->
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin slot="head" />
  
  <!-- Main Catalog Layout -->
  <CatalogLayout 
    products={products}
    allBrands={allBrands}
    allRims={allRims}
    allWidths={allWidths}
    allTypes={allTypes}
    allSeasons={allSeasons}
    title="Catálogo de Productos"
    description="Encuentra la llanta perfecta para tu vehículo con nuestro sistema de búsqueda avanzada"
    showHero={true}
    showStats={true}
  />
</Layout>

<style>
  /* Global CSS Variables for the catalog */
  :root {
    --primary-color: #0d4ba0;
    --secondary-color: #ffdd00;
    --success-color: #10b981;
    --warning-color: #f59e0b;
    --error-color: #ef4444;
    --info-color: #3b82f6;
    
    --text-primary: #111827;
    --text-secondary: #6b7280;
    --text-muted: #9ca3af;
    
    --bg-primary: #ffffff;
    --bg-secondary: #f8fafc;
    --bg-muted: #f1f5f9;
    
    --border-light: #e5e7eb;
    --border-medium: #d1d5db;
    --border-dark: #9ca3af;
    
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
    
    --max-width: 1200px;
    --max-width-prose: 65ch;
    
    --z-dropdown: 1000;
    --z-sticky: 1020;
    --z-fixed: 1030;
    --z-modal-backdrop: 1040;
    --z-modal: 1050;
    --z-popover: 1060;
    --z-tooltip: 1070;
    --z-toast: 1080;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    :root {
      --text-primary: #f9fafb;
      --text-secondary: #d1d5db;
      --text-muted: #9ca3af;
      
      --bg-primary: #111827;
      --bg-secondary: #1f2937;
      --bg-muted: #374151;
      
      --border-light: #374151;
      --border-medium: #4b5563;
      --border-dark: #6b7280;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    :root {
      --border-light: #000000;
      --border-medium: #000000;
      --border-dark: #000000;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Focus management */
  :focus {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Typography improvements */
  body {
    font-family: var(--font-family);
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
  }

  /* Utility classes */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Print styles */
  @media print {
    .no-print {
      display: none !important;
    }
    
    body {
      background: white !important;
      color: black !important;
    }
    
    a {
      text-decoration: underline;
    }
    
    a[href^="http"]:after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
    }
  }

  /* Performance optimizations */
  img {
    content-visibility: auto;
  }

  .catalog-grid {
    contain: layout style paint;
  }

  /* Loading states */
  .loading {
    pointer-events: none;
    opacity: 0.6;
  }

  /* Error states */
  .error {
    border-color: var(--error-color);
    background-color: rgba(239, 68, 68, 0.05);
  }

  /* Success states */
  .success {
    border-color: var(--success-color);
    background-color: rgba(16, 185, 129, 0.05);
  }
</style>

<script>
// Enhanced analytics and performance monitoring
class CatalogAnalytics {
  constructor() {
    this.startTime = performance.now();
    this.interactions = [];
    this.init();
  }

  init() {
    this.trackPageLoad();
    this.setupPerformanceObserver();
    this.setupErrorTracking();
    this.setupUserInteractionTracking();
  }

  trackPageLoad() {
    // Track initial page load
    window.addEventListener('load', () => {
      const loadTime = performance.now() - this.startTime;
      this.trackEvent('page_load', {
        load_time: Math.round(loadTime),
        products_count: document.querySelectorAll('.product-card').length,
        timestamp: Date.now()
      });
    });
  }

  setupPerformanceObserver() {
    if ('PerformanceObserver' in window) {
      // Track Largest Contentful Paint
      const lcpObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        const lastEntry = entries[entries.length - 1];
        this.trackEvent('lcp', {
          value: Math.round(lastEntry.startTime),
          timestamp: Date.now()
        });
      });
      lcpObserver.observe({ entryTypes: ['largest-contentful-paint'] });

      // Track First Input Delay
      const fidObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        entries.forEach((entry) => {
          this.trackEvent('fid', {
            value: Math.round(entry.processingStart - entry.startTime),
            timestamp: Date.now()
          });
        });
      });
      fidObserver.observe({ entryTypes: ['first-input'] });
    }
  }

  setupErrorTracking() {
    window.addEventListener('error', (event) => {
      this.trackEvent('javascript_error', {
        message: event.message,
        filename: event.filename,
        lineno: event.lineno,
        colno: event.colno,
        timestamp: Date.now()
      });
    });

    window.addEventListener('unhandledrejection', (event) => {
      this.trackEvent('promise_rejection', {
        reason: event.reason?.toString() || 'Unknown',
        timestamp: Date.now()
      });
    });
  }

  setupUserInteractionTracking() {
    // Track search interactions
    document.addEventListener('catalogSearch', (e) => {
      this.trackEvent('search', {
        query: e.detail.query,
        timestamp: Date.now()
      });
    });

    // Track filter interactions
    document.addEventListener('filtersChanged', (e) => {
      this.trackEvent('filters_applied', {
        active_filters: e.detail.activeFilters || 0,
        timestamp: Date.now()
      });
    });

    // Track product interactions
    document.addEventListener('click', (e) => {
      const productCard = e.target.closest('.product-card');
      if (productCard) {
        this.trackEvent('product_click', {
          product_id: productCard.dataset.productId,
          product_name: productCard.dataset.name,
          position: Array.from(document.querySelectorAll('.product-card')).indexOf(productCard) + 1,
          timestamp: Date.now()
        });
      }
    });
  }

  trackEvent(eventName, parameters = {}) {
    // Store interaction
    this.interactions.push({
      event: eventName,
      parameters,
      timestamp: Date.now()
    });

    // Send to analytics if available
    if (typeof gtag !== 'undefined') {
      gtag('event', eventName, {
        event_category: 'catalog',
        custom_map: { metric1: 'load_time' },
        ...parameters
      });
    }

    // Console log for development
    if (import.meta.env.DEV) {
      console.log(`📊 Analytics: ${eventName}`, parameters);
    }
  }

  getSessionData() {
    return {
      session_duration: Date.now() - this.startTime,
      interactions_count: this.interactions.length,
      interactions: this.interactions.slice(-10) // Last 10 interactions
    };
  }
}

// Initialize analytics
document.addEventListener('DOMContentLoaded', () => {
  window.catalogAnalytics = new CatalogAnalytics();
});

// Service Worker registration for offline support
if ('serviceWorker' in navigator && import.meta.env.PROD) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js')
      .then((registration) => {
        console.log('SW registered: ', registration);
      })
      .catch((registrationError) => {
        console.log('SW registration failed: ', registrationError);
      });
  });
}
</script>

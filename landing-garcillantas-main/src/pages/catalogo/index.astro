// Global functions - exposed to window for inline onclick handlers
window.clearAllFilters = function() {
  // Reset all filters
  document.querySelectorAll('.filter-select').forEach(select => {
    (select as HTMLSelectElement).value = '';
  });
  (document.getElementById('filter-price-min') as HTMLInputElement).value = '';
  (document.getElementById('filter-price-max') as HTMLInputElement).value = '';
  
  // Clear the main search input
  const mainSearchInput = document.getElementById('advanced-search-input') as HTMLInputElement;
  if (mainSearchInput) {
    mainSearchInput.value = '';
    // Trigger search clear
    if ((window as any).advancedSearch) {
      (window as any).advancedSearch.clearSearch();
    }
  }
  
  // Trigger filter update
  catalogManager.currentFilters = {};
  catalogManager.applyFiltersAndSort();
}

window.openComparison = function() {
  // Open comparison modal/panel
  if (window.catalogManager) {
    if (window.catalogManager.compareList && window.catalogManager.compareList.length > 0) {
      window.catalogManager.showComparisonPanel();
    } else {
      alert('No hay productos para comparar');
    }
  } else {
    console.error('CatalogManager not initialized');
  }
};

window.openFavorites = function() {
  // Open favorites modal/panel
  if (window.catalogManager) {
    if (window.catalogManager.favorites && window.catalogManager.favorites.length > 0) {
      window.catalogManager.showFavoritesPanel();
    } else {
      alert('No hay productos en favoritos');
    }
  } else {
    console.error('CatalogManager not initialized');
  }
};

// Search Tab Management
function initSearchTabs() {
  const tabs = document.querySelectorAll('.search-tab');
  const panels = document.querySelectorAll('.search-panel');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetTab = tab.dataset.tab;
      
      // Update active tab
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      
      // Update active panel
      panels.forEach(panel => {
        panel.classList.remove('active');
        if (panel.id === `${targetTab}-panel`) {
          panel.classList.add('active');
        }
      });
      
      // Clear other search when switching tabs
      if (targetTab === 'size') {
        // Clear advanced search
        if (window.advancedSearch) {
          window.advancedSearch.clearSearch();
        }
      } else {
        // Clear tire search
        if (window.tireSearchBySize) {
          window.tireSearchBySize.reset();
        }
      }
    });
  });
}

// Update WhatsApp links with selected tire size filters
function updateWhatsAppLinksWithFilters() {
  const catalogManager = (window as any).catalogManager;
  if (!catalogManager) return;

  // Get active tire size filters (from tire search or sidebar)
  const width = catalogManager.currentFilters.tireWidth || catalogManager.currentFilters.sidebarWidth || '';
  const profile = catalogManager.currentFilters.tireProfile || catalogManager.currentFilters.sidebarProfile || '';
  const rim = catalogManager.currentFilters.tireRim || catalogManager.currentFilters.sidebarRim || '';

  // Build tire size string if any filter is selected
  let tireSizeInfo = '';
  if (width || profile || rim) {
    const parts: string[] = [];
    if (width) parts.push(`Ancho: ${width}`);
    if (profile) parts.push(`Perfil: ${profile}`);
    if (rim) parts.push(`Rin: ${rim}`);
    tireSizeInfo = ` - Medida seleccionada: ${parts.join(', ')}`;
  }

  // Update all WhatsApp popup links
  document.querySelectorAll('.whatsapp-popup').forEach(popup => {
    const links = popup.querySelectorAll('.whatsapp-option') as NodeListOf<HTMLAnchorElement>;
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (!href) return;

      // Extract base URL and original message
      const url = new URL(href);
      let originalMessage = url.searchParams.get('text') || '';
      
      // Store original message if not already stored
      if (!link.dataset.originalMessage) {
        link.dataset.originalMessage = originalMessage;
      }

      // Build new message with tire size info
      let newMessage = link.dataset.originalMessage || '';
      if (tireSizeInfo && !newMessage.includes('Medida seleccionada:')) {
        newMessage = newMessage + tireSizeInfo;
      } else if (tireSizeInfo) {
        // Replace existing tire size info
        newMessage = newMessage.replace(/ - Medida seleccionada:.*$/, tireSizeInfo);
      } else {
        // Remove tire size info if no filters
        newMessage = newMessage.replace(/ - Medida seleccionada:.*$/, '');
      }

      url.searchParams.set('text', newMessage);
      link.setAttribute('href', url.toString());
    });
  });
}

// Listen for filter changes to update WhatsApp links
document.addEventListener('catalogFiltered', updateWhatsAppLinksWithFilters);
document.addEventListener('tireSearchBySize', updateWhatsAppLinksWithFilters);
document.addEventListener('sidebarFilters', updateWhatsAppLinksWithFilters);

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  window.catalogManager = new CatalogManager();
  initSearchTabs();
});
</script>


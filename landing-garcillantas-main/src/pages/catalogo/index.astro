---
import Layout from '../../layouts/Layout.astro';
import CatalogFilters from '@/components/CatalogFilters.astro';
import AdvancedSearch from '@/components/AdvancedSearch.astro';
import TireSearchBySize from '@/components/TireSearchBySize.astro';
import CatalogControls from '@/components/CatalogControls.astro';
import CatalogPagination from '@/components/CatalogPagination.astro';
import ProductCard from '@/components/ProductCard.astro';
import QuickViewProduct from '@/components/QuickViewProduct.astro';
import { getAllProducts, type Product } from '@/lib/contentful';

const title = 'Catálogo de Productos | Garcillantas';
const description = 'Explora nuestro catálogo completo de llantas con filtros avanzados, búsqueda inteligente y comparación de productos.';

const products = await getAllProducts();

// Extract filter options for simplified filters
const allRims = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? []).map(v => v.fields.rimSize))
)).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);

const allWidths = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? []).map(v => v.fields.width))
)).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);

const allProfiles = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? []).map(v => v.fields.aspectRatio))
)).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);

const allUsageTypes = Array.from(new Set(
  products.flatMap((p: Product) => (p.fields.variants ?? [])
    .flatMap(v => Array.isArray(v.fields.seasonUsage) ? v.fields.seasonUsage : (v.fields.seasonUsage ? [v.fields.seasonUsage] : [])))
)).sort();
---

<Layout title={title} description={description}>
  <div class="catalog-page">
    <!-- Hero Section -->
    <section class="catalog-hero">
      <div class="hero-content">
        <h1>Catálogo de Productos</h1>
        <p class="hero-description">
          Encuentra la llanta perfecta para tu vehículo con nuestro sistema de búsqueda avanzada
        </p>
        
        <!-- Search Components -->
        <div class="hero-search">
          <div class="search-tabs">
            <button class="search-tab" data-tab="advanced">Búsqueda General</button>
            <button class="search-tab active" data-tab="size">Búsqueda por Medida</button>
          </div>
          
          <div class="search-content">
            <div class="search-panel" id="advanced-panel">
              <AdvancedSearch products={products} />
            </div>
            <div class="search-panel active" id="size-panel">
              <TireSearchBySize products={products} showTitle={false} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Catalog Section -->
    <section class="catalog-main">
      <div class="catalog-container">
        
        <!-- Filters Sidebar -->
        <aside class="filters-sidebar">
          <CatalogFilters 
            allRims={allRims}
            allWidths={allWidths}
            allProfiles={allProfiles}
            allUsageTypes={allUsageTypes}
            totalProducts={products.length}
          />
        </aside>

        <!-- Products Section -->
        <main class="products-section">
          <!-- Catalog Controls -->
          <CatalogControls totalProducts={products.length} />

          <!-- Products Grid -->
          <div class="catalog-grid view-grid" id="catalog-grid">
            {products.map((product: Product) => (
              <ProductCard 
                product={product} 
                viewMode="grid" 
                showQuickView={true}
                lazyLoad={true}
              />
            ))}
          </div>

          <!-- Empty State -->
          <div class="empty-state" id="empty-state" style="display: none;">
            <div class="empty-content">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
              </svg>
              <h3>No se encontraron productos</h3>
              <p>Intenta ajustar los filtros o realizar una búsqueda diferente</p>
              <button class="clear-filters-btn" onclick="clearAllFilters()">
                Limpiar todos los filtros
              </button>
            </div>
          </div>

          <!-- Loading State -->
          <div class="loading-state" id="loading-state" style="display: none;">
            <div class="loading-content">
              <div class="loading-spinner"></div>
              <p>Cargando productos...</p>
            </div>
          </div>

          <!-- Pagination -->
          <CatalogPagination totalProducts={products.length} />
        </main>
      </div>
    </section>

    <!-- Quick View Modal -->
    <QuickViewProduct />

    <!-- Floating Action Buttons -->
    <div class="floating-actions">
      <button class="fab compare-fab" id="compare-fab" style="display: none;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z"/>
          <path d="M21 11h-4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z"/>
          <path d="M7 21V8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v13"/>
        </svg>
        <span class="fab-label">Comparar (<span id="compare-count">0</span>)</span>
      </button>

      <button class="fab favorites-fab" id="favorites-fab" style="display: none;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="fab-label">Favoritos (<span id="favorites-count">0</span>)</span>
      </button>
    </div>
  </div>
</Layout>

<script>
// Catalog Management System
class CatalogManager {
  constructor() {
    this.products = [];
    this.filteredProducts = [];
    this.currentFilters = {};
    this.currentSort = 'relevance';
    this.currentView = 'grid';
    this.currentPage = 1;
    this.itemsPerPage = 24;
    this.favorites = this.loadFavorites();
    this.compareList = this.loadCompareList();
    
    this.init();
  }

  init() {
    this.loadProducts();
    this.setupEventListeners();
    this.updateFavoriteButtons();
    this.updateCompareButtons();
    this.updateFabVisibility();
  }

  loadProducts() {
    const productCards = document.querySelectorAll('.product-card');
    this.products = Array.from(productCards).map(card => ({
      element: card,
      id: card.dataset.productId,
      slug: card.dataset.slug,
      name: card.dataset.displayName || card.dataset.name,
      brand: card.dataset.displayBrand || card.dataset.brand,
      model: card.dataset.model,
      category: card.dataset.category,
      image: card.dataset.image || '',
      rims: card.dataset.rims ? card.dataset.rims.split(',') : [],
      widths: card.dataset.widths ? card.dataset.widths.split(',') : [],
      types: card.dataset.types ? card.dataset.types.split(',') : [],
      seasons: card.dataset.seasons ? card.dataset.seasons.split(',') : [],
      minPrice: card.dataset.minPrice ? parseFloat(card.dataset.minPrice) : null,
      maxPrice: card.dataset.maxPrice ? parseFloat(card.dataset.maxPrice) : null,
      featured: card.dataset.featured === 'true',
      stock: parseInt(card.dataset.stock) || 0
    }));
    
    this.filteredProducts = [...this.products];
    this.applyFiltersAndSort();
  }

  setupEventListeners() {
    // Filter events
    document.addEventListener('catalogSearch', (e) => {
      this.currentFilters.search = e.detail.query;
      this.applyFiltersAndSort();
    });

    // Tire search by size events
    document.addEventListener('tireSearchBySize', (e) => {
      console.log('CatalogManager: Received tireSearchBySize event:', e.detail);
      
      if (e.detail.clear) {
        // Clear tire search filters
        this.currentFilters.tireWidth = '';
        this.currentFilters.tireProfile = '';
        this.currentFilters.tireRim = '';
        this.currentFilters.tireSearch = '';
        console.log('CatalogManager: Cleared tire search filters');
      } else {
        // Set tire search filters
        this.currentFilters.tireWidth = e.detail.width;
        this.currentFilters.tireProfile = e.detail.profile;
        this.currentFilters.tireRim = e.detail.rim;
        this.currentFilters.tireSearch = e.detail.query;
        console.log('CatalogManager: Set tire search filters:', {
          width: this.currentFilters.tireWidth,
          profile: this.currentFilters.tireProfile,
          rim: this.currentFilters.tireRim,
          query: this.currentFilters.tireSearch
        });
      }
      this.applyFiltersAndSort();
    });

    // Sidebar filters events
    document.addEventListener('sidebarFilters', (e) => {
      console.log('CatalogManager: Received sidebarFilters event:', e.detail);
      
      if (e.detail.clear) {
        // Clear sidebar filters
        this.currentFilters.sidebarWidth = '';
        this.currentFilters.sidebarProfile = '';
        this.currentFilters.sidebarRim = '';
        this.currentFilters.sidebarUsageType = '';
        console.log('CatalogManager: Cleared sidebar filters');
      } else {
        // Set sidebar filters
        this.currentFilters.sidebarWidth = e.detail.width;
        this.currentFilters.sidebarProfile = e.detail.profile;
        this.currentFilters.sidebarRim = e.detail.rim;
        this.currentFilters.sidebarUsageType = e.detail.usageType;
        console.log('CatalogManager: Set sidebar filters:', {
          width: this.currentFilters.sidebarWidth,
          profile: this.currentFilters.sidebarProfile,
          rim: this.currentFilters.sidebarRim,
          usageType: this.currentFilters.sidebarUsageType
        });
      }
      this.applyFiltersAndSort();
    });

    // Sort and view events
    document.addEventListener('sortChanged', (e) => {
      this.currentSort = e.detail.sort;
      this.applyFiltersAndSort();
    });

    document.addEventListener('viewModeChanged', (e) => {
      this.currentView = e.detail.view;
      this.updateView();
    });

    document.addEventListener('itemsPerPageChanged', (e) => {
      this.itemsPerPage = e.detail.itemsPerPage;
      this.currentPage = 1;
      this.applyPagination();
    });

    document.addEventListener('paginationChanged', (e) => {
      this.currentPage = e.detail.page;
      this.applyPagination();
    });

    // Product interaction events
    document.addEventListener('click', (e) => {
      const quickViewBtn = e.target.closest('.quick-view-btn');
      const favoriteBtn = e.target.closest('.favorite-btn');
      const compareBtn = e.target.closest('.compare-btn');

      if (quickViewBtn) {
        this.openQuickView(quickViewBtn.dataset.productSlug);
      } else if (favoriteBtn) {
        this.toggleFavorite(favoriteBtn.dataset.productId);
      } else if (compareBtn) {
        this.toggleCompare(compareBtn.dataset.productId);
      }
    });

    // Listen for favorites/compare updates from QuickViewProduct
    document.addEventListener('favoritesUpdated', (e) => {
      this.favorites = e.detail.favorites;
      this.updateFavoriteButtons();
      this.updateFabVisibility();
    });

    document.addEventListener('compareListUpdated', (e) => {
      this.compareList = e.detail.compareList;
      this.updateCompareButtons();
      this.updateFabVisibility();
    });

    // FAB button event listeners
    const favoritesFab = document.getElementById('favorites-fab');
    const compareFab = document.getElementById('compare-fab');

    if (favoritesFab) {
      favoritesFab.addEventListener('click', () => {
        this.showFavoritesPanel();
      });
    }

    if (compareFab) {
      compareFab.addEventListener('click', () => {
        this.showComparisonPanel();
      });
    }
  }

  applyFiltersAndSort() {
    // Apply filters
    this.filteredProducts = this.products.filter(product => {
      // Enhanced search filter
      if (this.currentFilters.search) {
        const searchTerm = this.currentFilters.search.toLowerCase().trim();
        
        // Basic search fields
        const basicFields = [
          product.name,
          product.brand,
          product.model,
          product.category
        ].filter(field => field).join(' ').toLowerCase();
        
        // Tire dimension fields
        const dimensionFields = [
          ...product.rims.map(rim => `${rim}"`),
          ...product.rims.map(rim => `R${rim}`),
          ...product.rims.map(rim => `Rin ${rim}`),
          ...product.widths,
          ...product.types,
          ...product.seasons
        ].join(' ').toLowerCase();
        
        // Combined search string
        const allSearchFields = `${basicFields} ${dimensionFields}`;
        
        // Check for direct match
        if (allSearchFields.includes(searchTerm)) return true;
        
        // Check for fuzzy tire dimension match (e.g., "225 60 16" should match "225/60R16")
        if (/^\d+[\s\/]*\d*[\s\/]*\d*$/.test(searchTerm)) {
          const normalizedSearch = searchTerm.replace(/[\s\/]+/g, '/');
          const normalizedFields = allSearchFields.replace(/[r\s]/g, '/');
          if (normalizedFields.includes(normalizedSearch)) return true;
        }
        
        // Check individual words for partial matching
        const searchWords = searchTerm.split(/\s+/);
        const hasAllWords = searchWords.every((word: string) => 
          word.length > 0 && allSearchFields.includes(word)
        );
        
        if (!hasAllWords) return false;
      }

      // Tire search by size filters (from hero section)
      if (this.currentFilters.tireWidth || this.currentFilters.tireProfile || this.currentFilters.tireRim) {
        console.log('CatalogManager: Filtering product:', product.name, 'with tire filters:', {
          width: this.currentFilters.tireWidth,
          profile: this.currentFilters.tireProfile,
          rim: this.currentFilters.tireRim
        });
        
        let matchesTireSearch = false;
        
        // Check using data attributes (simpler and more reliable)
        let attributeMatch = true;
        
        if (this.currentFilters.tireWidth) {
          const widths = product.element.dataset.widths ? product.element.dataset.widths.split(',') : [];
          console.log('Product widths:', widths, 'Looking for:', this.currentFilters.tireWidth);
          if (!widths.includes(this.currentFilters.tireWidth)) {
            attributeMatch = false;
          }
        }
        
        if (this.currentFilters.tireProfile && attributeMatch) {
          const profiles = product.element.dataset.profiles ? product.element.dataset.profiles.split(',') : [];
          console.log('Product profiles:', profiles, 'Looking for:', this.currentFilters.tireProfile);
          if (!profiles.includes(this.currentFilters.tireProfile)) {
            attributeMatch = false;
          }
        }
        
        if (this.currentFilters.tireRim && attributeMatch) {
          const rims = product.element.dataset.rims ? product.element.dataset.rims.split(',') : [];
          console.log('Product rims:', rims, 'Looking for:', this.currentFilters.tireRim);
          if (!rims.includes(this.currentFilters.tireRim)) {
            attributeMatch = false;
          }
        }
        
        matchesTireSearch = attributeMatch;
        console.log('Product match result:', matchesTireSearch);
        
        if (!matchesTireSearch) {
          return false;
        }
      }

      // Sidebar filters
      if (this.currentFilters.sidebarWidth || this.currentFilters.sidebarProfile || this.currentFilters.sidebarRim || this.currentFilters.sidebarUsageType) {
        console.log('CatalogManager: Filtering product:', product.name, 'with sidebar filters:', {
          width: this.currentFilters.sidebarWidth,
          profile: this.currentFilters.sidebarProfile,
          rim: this.currentFilters.sidebarRim,
          usageType: this.currentFilters.sidebarUsageType
        });
        
        let sidebarMatch = true;
        
        if (this.currentFilters.sidebarWidth) {
          const widths = product.element.dataset.widths ? product.element.dataset.widths.split(',') : [];
          if (!widths.includes(this.currentFilters.sidebarWidth)) {
            sidebarMatch = false;
          }
        }
        
        if (this.currentFilters.sidebarProfile && sidebarMatch) {
          const profiles = product.element.dataset.profiles ? product.element.dataset.profiles.split(',') : [];
          if (!profiles.includes(this.currentFilters.sidebarProfile)) {
            sidebarMatch = false;
          }
        }
        
        if (this.currentFilters.sidebarRim && sidebarMatch) {
          const rims = product.element.dataset.rims ? product.element.dataset.rims.split(',') : [];
          if (!rims.includes(this.currentFilters.sidebarRim)) {
            sidebarMatch = false;
          }
        }

        if (this.currentFilters.sidebarUsageType && sidebarMatch) {
          const seasons = product.element.dataset.seasons ? product.element.dataset.seasons.split(',') : [];
          if (!seasons.includes(this.currentFilters.sidebarUsageType)) {
            sidebarMatch = false;
          }
        }
        
        console.log('Sidebar filter match result:', sidebarMatch);
        
        if (!sidebarMatch) {
          return false;
        }
      }

      // Other filters would be applied here
      return true;
    });

    // Apply sorting
    this.sortProducts();
    
    // Update display
    this.updateProductDisplay();
    this.applyPagination();
    
    // Dispatch event for other components
    document.dispatchEvent(new CustomEvent('catalogFiltered', {
      detail: {
        visibleCount: this.filteredProducts.length,
        totalCount: this.products.length
      }
    }));
    
    // Dispatch tire search results count
    document.dispatchEvent(new CustomEvent('tireSearchResults', {
      detail: {
        count: this.filteredProducts.length
      }
    }));
  }

  sortProducts() {
    this.filteredProducts.sort((a, b) => {
      switch (this.currentSort) {
        case 'name-asc':
          return a.name.localeCompare(b.name);
        case 'name-desc':
          return b.name.localeCompare(a.name);
        case 'price-asc':
          return (a.minPrice || 0) - (b.minPrice || 0);
        case 'price-desc':
          return (b.maxPrice || 0) - (a.maxPrice || 0);
        case 'brand-asc':
          return a.brand.localeCompare(b.brand);
        case 'brand-desc':
          return b.brand.localeCompare(a.brand);
        case 'featured':
          return b.featured - a.featured;
        case 'newest':
          // Would need creation date from Contentful
          return 0;
        default:
          return 0;
      }
    });
  }

  updateProductDisplay() {
    const catalogGrid = document.getElementById('catalog-grid');
    const emptyState = document.getElementById('empty-state');
    
    // First, hide all products
    this.products.forEach(product => {
      product.element.style.display = 'none';
    });
    
    if (this.filteredProducts.length === 0) {
      catalogGrid.style.display = 'none';
      emptyState.style.display = 'flex';
    } else {
      catalogGrid.style.display = 'grid';
      emptyState.style.display = 'none';
      
      // Show only filtered products
      this.filteredProducts.forEach(product => {
        product.element.style.display = '';
      });
    }
  }

  applyPagination() {
    // First, hide all products
    this.products.forEach(product => {
      product.element.style.display = 'none';
    });

    if (this.filteredProducts.length === 0) {
      return;
    }

    if (this.itemsPerPage === 'all') {
      // Show all filtered products
      this.filteredProducts.forEach(product => {
        product.element.style.display = '';
      });
      return;
    }

    // Apply pagination to filtered products
    const startIndex = (this.currentPage - 1) * this.itemsPerPage;
    const endIndex = startIndex + this.itemsPerPage;

    this.filteredProducts.forEach((product, index) => {
      product.element.style.display = (index >= startIndex && index < endIndex) ? '' : 'none';
    });
  }

  updateView() {
    const catalogGrid = document.getElementById('catalog-grid');
    catalogGrid.className = `catalog-grid view-${this.currentView}`;
    
    this.products.forEach(product => {
      product.element.className = `product-card ${this.currentView}`;
    });
  }

  toggleFavorite(productId) {
    const index = this.favorites.indexOf(productId);
    if (index > -1) {
      this.favorites.splice(index, 1);
    } else {
      this.favorites.push(productId);
    }
    
    this.saveFavorites();
    this.updateFavoriteButtons();
    this.updateFabVisibility();
  }

  toggleCompare(productId) {
    const index = this.compareList.indexOf(productId);
    if (index > -1) {
      this.compareList.splice(index, 1);
    } else if (this.compareList.length < 4) {
      this.compareList.push(productId);
    } else {
      alert('Máximo 4 productos para comparar');
      return;
    }
    
    this.saveCompareList();
    this.updateCompareButtons();
    this.updateFabVisibility();
  }

  updateFavoriteButtons() {
    document.querySelectorAll('.favorite-btn').forEach(btn => {
      const productId = btn.dataset.productId;
      btn.classList.toggle('active', this.favorites.includes(productId));
    });
  }

  updateCompareButtons() {
    document.querySelectorAll('.compare-btn').forEach(btn => {
      const productId = btn.dataset.productId;
      btn.classList.toggle('active', this.compareList.includes(productId));
    });
  }

  updateFabVisibility() {
    const compareCount = document.getElementById('compare-count');
    const favoritesCount = document.getElementById('favorites-count');
    const compareFab = document.getElementById('compare-fab');
    const favoritesFab = document.getElementById('favorites-fab');

    compareCount.textContent = this.compareList.length;
    favoritesCount.textContent = this.favorites.length;

    compareFab.style.display = this.compareList.length > 0 ? 'flex' : 'none';
    favoritesFab.style.display = this.favorites.length > 0 ? 'flex' : 'none';
  }

  loadFavorites() {
    try {
      return JSON.parse(localStorage.getItem('garcillantas_favorites') || '[]');
    } catch {
      return [];
    }
  }

  saveFavorites() {
    try {
      localStorage.setItem('garcillantas_favorites', JSON.stringify(this.favorites));
    } catch {
      // Handle errors silently
    }
  }

  loadCompareList() {
    try {
      return JSON.parse(localStorage.getItem('garcillantas_compare') || '[]');
    } catch {
      return [];
    }
  }

  saveCompareList() {
    try {
      localStorage.setItem('garcillantas_compare', JSON.stringify(this.compareList));
    } catch {
      // Handle errors silently
    }
  }

  // Show favorites panel/modal
  showFavoritesPanel() {
    const favoriteProducts = this.products.filter(p => this.favorites.includes(p.id));
    
    if (favoriteProducts.length === 0) {
      alert('No hay productos en favoritos');
      return;
    }

    // Create and show favorites modal
    let modal = document.getElementById('favorites-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'favorites-modal';
      modal.className = 'favorites-modal';
      document.body.appendChild(modal);
    }

    const whatsappNumber = '573174406744'; // Número de WhatsApp de Garcillantas
    const productsList = favoriteProducts.map(p => {
      const whatsappMessage = encodeURIComponent(`Hola, me interesa consultar el precio de: ${p.name} (${p.brand} - ${p.model})`);
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
      
      return `
      <div class="favorite-item" data-product-id="${p.id}">
        <div class="favorite-item-image">
          ${p.image ? `<img src="${p.image}" alt="${p.name}" loading="lazy" />` : `
            <div class="favorite-item-no-image">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21,15 16,10 5,21"/>
              </svg>
            </div>
          `}
        </div>
        <div class="favorite-item-content">
          <div class="favorite-item-info">
            <strong>${p.name}</strong>
            <span>${p.brand} - ${p.model}</span>
          </div>
          <div class="favorite-item-actions">
            <a href="${whatsappUrl}" target="_blank" rel="noopener noreferrer" class="favorite-whatsapp-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">

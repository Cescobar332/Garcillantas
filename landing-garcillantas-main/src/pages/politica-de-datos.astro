---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="container-box">
  <div class="pdf-container">
    <iframe 
      src="/documents/politica-de-tratamiento-de-datos-garcillantas.pdf" 
      width="100%"
      height="600px" 
      style="border: none;"
      title="Política de Tratamiento de Datos"
    ></iframe>
  </div>
</div>
</Layout>

<style>
  .container-box {
    width: 80vw;
    margin: 0 auto;
  }

  .pdf-container {
    width: 100%; 
    padding: 1rem;
    box-sizing: border-box;
  }

  .pdf-container iframe {
    width: 100%; /* Ensure the iframe takes full width */
    height: 800px;
    border: none;
  }

  @media (max-width: 768px) {
    .pdf-container iframe {
      height: 400px; /* Adjust height for mobile view */
    }
    .container-box {
      width: 100%;
    }
  }
</style>
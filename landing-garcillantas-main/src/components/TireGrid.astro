---
import TireCard from "./TireCard.astro";
import { getAllTires } from "../lib/contentful";

const tires = await getAllTires();

const formattedTires = tires.map((tire) => ({
  id: tire.fields.slug,
  title: tire.fields.title,
  brand: tire.fields.brand || { fields: { brand: "Sin marca" } },
  design: tire.fields.design,
  image: tire.fields.featuredImage?.fields.file.url || "/images/tire.webp",
}));

// Obtener marcas únicas
const uniqueBrands = [
  ...new Set(formattedTires.map((tire) => tire.brand.fields.brand)),
].sort();

interface Props {
  icon?: string;
  variant?: "primary" | "outline";
  popupId?: string;
  messageParam?: string;
}
const {
  icon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>',
  variant = "primary",
  popupId = crypto.randomUUID(),
  messageParam,
} = Astro.props;
---

<section class="tires-section" id="llantas">
  <div class="filter-section">
    <select id="brandFilter" class="brand-filter">
      <option value="">Todas las marcas</option>
      {uniqueBrands.map((brand) => <option value={brand}>{brand}</option>)}
    </select>
  </div>

  <div class="tires-grid" id="tiresGrid">
    {
      formattedTires.map((tire) => (
        <TireCard
          {...tire}
          icon={icon}
          variant={variant}
          popupId={popupId}
          message={`?text=${encodeURIComponent(`Hola, estoy interesado en la llanta ${tire.brand.fields.brand} ${tire.design}`)}`}
        />
      ))
    }
  </div>
</section>
<div class="popup whatsapp-popup tire-grid-popup" id={popupId}>
  <div class="popup-content">
    <button class="close-btn whatsapp-close">×</button>
    <h3>Seleccione una sede</h3>
    <div class="popup-buttons">
      <a href="" id="santander" target="_blank" class="whatsapp-option">
        <span set:html={icon} />
        Sedes Santander
      </a>
      <a href="" id="caribe" target="_blank" class="whatsapp-option">
        <span set:html={icon} />
        Sedes Caribe
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const brandFilter = document.getElementById("brandFilter");
    const tiresGrid = document.getElementById("tiresGrid");
    let currentSearchTerm = "";
    let currentBrand = "";

    // Mover el popup al body para evitar problemas de contexto de apilamiento con transformaciones
    const popup = document.querySelector(".tire-grid-popup");
    if (popup && popup.parentElement !== document.body) {
      document.body.appendChild(popup);
    }

    // Función para filtrar las llantas
    const filterTires = () => {
      const tireCards = tiresGrid?.querySelectorAll(".tire-card") || [];

      tireCards.forEach((card) => {
        const tireBrand = card.getAttribute("data-brand");
        const tireTitle =
          card.querySelector(".tire-title")?.textContent?.toLowerCase() || "";
        const tireDesign =
          card.querySelector(".design")?.textContent?.toLowerCase() || "";

        const matchesBrand = !currentBrand || tireBrand === currentBrand;
        const matchesSearch =
          !currentSearchTerm ||
          tireTitle.includes(currentSearchTerm) ||
          tireDesign.includes(currentSearchTerm) ||
          tireBrand?.toLowerCase().includes(currentSearchTerm);

        (card as HTMLElement).style.display =
          matchesBrand && matchesSearch ? "" : "none";
      });
    };

    // Evento para el filtro de marca
    const handleBrandChange = (e: Event) => {
      currentBrand = (e.target as HTMLSelectElement)?.value || "";
      filterTires();
    };
    brandFilter?.addEventListener("change", handleBrandChange);

    // Escuchar eventos de búsqueda desde TireSearch
    const handleTireSearch = (e: Event) => {
      const customEvent = e as CustomEvent<{ searchTerm: string }>;
      currentSearchTerm = customEvent.detail.searchTerm.toLowerCase();
      filterTires();
    };
    window.addEventListener("tireSearch", handleTireSearch);

    // Manejador de clicks para popups
    const handlePopupClick = (event: MouseEvent) => {
      const target = event.target as HTMLElement;

      // Delegación de eventos para el botón de apertura
      const trigger = target.closest(".tire-whatsapp-trigger");
      if (trigger && trigger instanceof HTMLElement) {
        const popupId = trigger.dataset.popupId;
        if (popupId) {
          const popup = document.getElementById(popupId);
          if (popup) {
            const santanderBtn = popup.querySelector(
              "#santander",
            ) as HTMLAnchorElement;
            const caribeBtn = popup.querySelector(
              "#caribe",
            ) as HTMLAnchorElement;

            if (santanderBtn && trigger.dataset.urlsantander) {
              santanderBtn.href = trigger.dataset.urlsantander;
            }
            if (caribeBtn && trigger.dataset.urlcaribe) {
              caribeBtn.href = trigger.dataset.urlcaribe;
            }
            popup.style.display = "block";
          }
        }
      }

      // Delegación de eventos para el botón de cierre
      if (target.closest(".whatsapp-close")) {
        const popup = target.closest(".whatsapp-popup") as HTMLElement;
        if (popup) {
          popup.style.display = "none";
        }
      }

      // Cierre al hacer clic fuera del contenido
      if (target.classList.contains("whatsapp-popup")) {
        target.style.display = "none";
      }
    };

    document.addEventListener("click", handlePopupClick);

    // Cierre con tecla Escape
    const handleEscapeKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        document.querySelectorAll(".whatsapp-popup").forEach((popup) => {
          (popup as HTMLElement).style.display = "none";
        });
      }
    };
    document.addEventListener("keydown", handleEscapeKey);

    // Cleanup function
    const cleanup = () => {
      window.removeEventListener("tireSearch", handleTireSearch);
      document.removeEventListener("click", handlePopupClick);
      document.removeEventListener("keydown", handleEscapeKey);

      // Remover el popup del body si fue movido
      if (popup && popup.parentElement === document.body) {
        document.body.removeChild(popup);
      }

      // Elements like brandFilter are replaced, so their listeners are GC'd,
      // but explicit removal is safe.
      brandFilter?.removeEventListener("change", handleBrandChange);
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  });
</script>

<style>
  .tires-section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1rem;
    box-sizing: border-box;
  }

  .section-title {
    font-size: 3rem;
    font-weight: bold;
    text-align: center;
    margin-bottom: 0.5rem;
    color: var(--primary-color);
    position: relative;
    display: inline-block;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-family-display);
  }

  .subtitle {
    text-align: center;
    color: #4a5568;
    font-size: 1.2rem;
    margin-bottom: 4rem;
    opacity: 0.9;
  }

  .filter-section {
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
  }

  .brand-filter {
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--primary-color);
    border-radius: 0.5rem;
    font-size: 1rem;
    color: var(--primary-color);
    background-color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .brand-filter:hover {
    background-color: var(--primary-color);
    color: white;
  }

  .brand-filter:focus {
    outline: none;
    box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb), 0.2);
  }

  .tires-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    align-items: stretch;
    box-sizing: border-box;
  }

  .popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(5px);
    z-index: 10000;
  }

  .popup-content {
    position: relative;
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    max-width: 400px;
    margin: 20% auto;
  }

  .popup-content h3 {
    margin: 0;
    font-size: 1.5em;
    text-align: center;
    color: var(--primary-color);
  }

  .close-btn {
    position: absolute;
    right: 10px;
    top: 10px;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--primary-color);
    cursor: pointer;
  }

  .popup-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }

  .whatsapp-option {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    font-weight: bold;
    border-radius: 5px;
    transition: background-color 0.3s;
  }

  .whatsapp-option:hover {
    background-color: var(--secondary-color);
    color: var(--primary-color);
  }

  @media (max-width: 639px) {
    .section-title {
      font-size: 2rem;
    }

    .filter-section {
      margin: 1rem 0.5rem 2rem;
    }

    .brand-filter {
      width: 100%;
      max-width: 100%;
    }
  }

  @media (width <= 640px) {
    .tires-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 0.5rem;
    }
  }
</style>

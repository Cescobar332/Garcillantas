---
interface Props {
  totalProducts: number;
}

const { totalProducts } = Astro.props;
---

<div class="pagination-container" id="pagination-container" style="display: flex; justify-content: center; align-items: center; margin-top: 2rem; padding-top: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div class="pagination" id="pagination" style="display: flex; align-items: center; gap: 0.5rem; background: transparent; padding: 0;">
    <!-- Botones iniciales que se actualizarán dinámicamente -->
    <button class="pagination-btn pagination-prev disabled" disabled title="Página anterior" style="padding: 0.5rem 0.75rem; border: none; background: #f1f5f9; color: #94a3b8; cursor: not-allowed; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; outline: none; opacity: 0.4;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"/>
      </svg>
    </button>
    <button class="pagination-btn pagination-number active" aria-current="page" title="Página 1" style="padding: 0.5rem 0.75rem; border: none; background: var(--primary-color); color: white; cursor: pointer; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 600; display: flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; outline: none;">1</button>
    <button class="pagination-btn pagination-number" onclick="catalogPagination.goToPage(2)" title="Página 2" style="padding: 0.5rem 0.75rem; border: none; background: #f1f5f9; color: #64748b; cursor: pointer; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; outline: none;">2</button>
    <button class="pagination-btn pagination-next" onclick="catalogPagination.goToPage(2)" title="Página siguiente" style="padding: 0.5rem 0.75rem; border: none; background: #f1f5f9; color: #64748b; cursor: pointer; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; outline: none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9,18 15,12 9,6"/>
      </svg>
    </button>
  </div>
  <div class="pagination-info" style="font-size: 0.875rem; color: #64748b; font-weight: 500; background: transparent; padding: 0.5rem 0; white-space: nowrap;">
    <span id="pagination-info">Mostrando 1-24 de 48 productos</span>
  </div>
</div>

<script>
class CatalogPagination {
  constructor() {
    this.currentPage = 1;
    this.itemsPerPage = 24;
    this.filteredItems = 0;
    
    this.init();
  }

  init() {
    // Listen for filter updates
    document.addEventListener('catalogFiltered', (e) => {
      this.updateResults(e.detail.visibleCount);
    });

    // Listen for pagination events
    document.addEventListener('paginationChanged', (e) => {
      this.currentPage = e.detail.page;
      this.updatePagination();
    });

    // Listen for items per page changes
    document.addEventListener('itemsPerPageChanged', (e) => {
      this.itemsPerPage = e.detail.itemsPerPage;
      this.currentPage = 1;
      this.updatePagination();
    });

    // Listen for search events
    document.addEventListener('catalogSearch', (e) => {
      this.currentPage = 1;
      this.updatePagination();
    });

    // Load saved preferences
    this.loadPreferences();
  }

  updateResults(visibleCount) {
    this.filteredItems = visibleCount;
    this.updatePagination();
  }

  updatePagination() {
    const paginationContainer = document.getElementById('pagination-container');
    const pagination = document.getElementById('pagination');
    const paginationInfo = document.getElementById('pagination-info');
    
    if (!pagination || !paginationInfo) return;

    if (this.itemsPerPage === 'all' || this.filteredItems <= this.itemsPerPage) {
      paginationContainer.style.display = 'none';
      return;
    }

    paginationContainer.style.display = 'flex';
    
    const totalPages = Math.ceil(this.filteredItems / this.itemsPerPage);
    const startItem = (this.currentPage - 1) * this.itemsPerPage + 1;
    const endItem = Math.min(this.currentPage * this.itemsPerPage, this.filteredItems);
    
    // Update pagination info
    paginationInfo.textContent = `Mostrando ${startItem}-${endItem} de ${this.filteredItems} productos`;
    
    // Generate pagination buttons with inline styles
    let paginationHTML = '';
    
    const baseButtonStyle = 'padding: 0.5rem 0.75rem; border: none; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; outline: none; transition: all 0.2s ease;';
    const normalButtonStyle = baseButtonStyle + ' background: #f1f5f9; color: #64748b; cursor: pointer;';
    const activeButtonStyle = baseButtonStyle + ' background: var(--primary-color); color: white; font-weight: 600; cursor: pointer;';
    const disabledButtonStyle = baseButtonStyle + ' background: #f1f5f9; color: #94a3b8; cursor: not-allowed; opacity: 0.4;';
    
    // First page button
    if (this.currentPage > 2) {
      paginationHTML += `<button class="pagination-btn pagination-first" onclick="catalogPagination.goToPage(1)" title="Primera página" style="${normalButtonStyle}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="11,17 6,12 11,7"/>
          <polyline points="18,17 13,12 18,7"/>
        </svg>
      </button>`;
    }
    
    // Previous button
    const prevDisabled = this.currentPage <= 1;
    paginationHTML += `<button class="pagination-btn pagination-prev ${prevDisabled ? 'disabled' : ''}" 
      ${prevDisabled ? 'disabled' : `onclick="catalogPagination.goToPage(${this.currentPage - 1})"`} 
      title="Página anterior" style="${prevDisabled ? disabledButtonStyle : normalButtonStyle}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"/>
      </svg>
    </button>`;
    
    // Page numbers
    const maxVisiblePages = 5;
    let startPage = Math.max(1, this.currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }
    
    if (startPage > 1) {
      paginationHTML += `<button class="pagination-btn pagination-number" onclick="catalogPagination.goToPage(1)" title="Página 1" style="${normalButtonStyle}">1</button>`;
      if (startPage > 2) {
        paginationHTML += `<span class="pagination-ellipsis" title="Más páginas" style="padding: 0.5rem 0.75rem; color: #64748b; font-size: 0.875rem; font-weight: 500; user-select: none; display: flex; align-items: center; justify-content: center; background: transparent; min-width: 36px; min-height: 36px;">⋯</span>`;
      }
    }
    
    for (let i = startPage; i <= endPage; i++) {
      const isActive = i === this.currentPage;
      paginationHTML += `<button class="pagination-btn pagination-number ${isActive ? 'active' : ''}" 
        ${isActive ? '' : `onclick="catalogPagination.goToPage(${i})"`} 
        title="Página ${i}" 
        ${isActive ? 'aria-current="page"' : ''} 
        style="${isActive ? activeButtonStyle : normalButtonStyle}">${i}</button>`;
    }
    
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        paginationHTML += `<span class="pagination-ellipsis" title="Más páginas" style="padding: 0.5rem 0.75rem; color: #64748b; font-size: 0.875rem; font-weight: 500; user-select: none; display: flex; align-items: center; justify-content: center; background: transparent; min-width: 36px; min-height: 36px;">⋯</span>`;
      }
      paginationHTML += `<button class="pagination-btn pagination-number" onclick="catalogPagination.goToPage(${totalPages})" title="Página ${totalPages}" style="${normalButtonStyle}">${totalPages}</button>`;
    }
    
    // Next button
    const nextDisabled = this.currentPage >= totalPages;
    paginationHTML += `<button class="pagination-btn pagination-next ${nextDisabled ? 'disabled' : ''}" 
      ${nextDisabled ? 'disabled' : `onclick="catalogPagination.goToPage(${this.currentPage + 1})"`} 
      title="Página siguiente" style="${nextDisabled ? disabledButtonStyle : normalButtonStyle}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9,18 15,12 9,6"/>
      </svg>
    </button>`;
    
    // Last page button
    if (this.currentPage < totalPages - 1) {
      paginationHTML += `<button class="pagination-btn pagination-last" onclick="catalogPagination.goToPage(${totalPages})" title="Última página" style="${normalButtonStyle}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="13,17 18,12 13,7"/>
          <polyline points="6,17 11,12 6,7"/>
        </svg>
      </button>`;
    }
    
    pagination.innerHTML = paginationHTML;
    
    // Dispatch pagination event
    document.dispatchEvent(new CustomEvent('paginationChanged', {
      detail: { 
        page: this.currentPage, 
        itemsPerPage: this.itemsPerPage,
        startItem: startItem - 1, // 0-based index
        endItem: endItem - 1 // 0-based index
      }
    }));
  }

  goToPage(page) {
    this.currentPage = page;
    this.updatePagination();
    
    // Scroll to top of catalog
    const catalogGrid = document.querySelector('.catalog-grid, .results-grid');
    if (catalogGrid) {
      catalogGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  loadPreferences() {
    try {
      const saved = localStorage.getItem('garcillantas_catalog_preferences');
      if (saved) {
        const preferences = JSON.parse(saved);
        
        if (preferences.itemsPerPage) {
          this.itemsPerPage = preferences.itemsPerPage;
        }
      }
    } catch (e) {
      // Handle localStorage errors silently
    }
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  window.catalogPagination = new CatalogPagination();
});
</script>

<style>
  /* Reset de botones para evitar conflictos */
  .pagination button {
    all: unset;
    box-sizing: border-box;
  }
  
  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    padding: 0;
  }

  .pagination-btn {
    padding: 0.5rem 0.75rem !important;
    border: none !important;
    background: #f1f5f9 !important;
    color: #64748b !important;
    cursor: pointer !important;
    border-radius: 0.375rem !important;
    font-size: 0.875rem !important;
    font-weight: 500 !important;
    transition: all 0.2s ease !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 36px !important;
    min-height: 36px !important;
    outline: none !important;
    box-shadow: none !important;
    text-decoration: none !important;
  }

  /* Número de página */
  .pagination-number {
    min-width: 36px;
    font-weight: 500;
  }

  /* Estados hover para todos los botones */
  .pagination-btn:hover:not(.disabled):not(.active) {
    background: #e2e8f0 !important;
    color: #475569 !important;
  }

  /* Estado activo */
  .pagination-btn.active {
    background: #3b82f6 !important;
    color: white !important;
    font-weight: 600 !important;
  }

  .pagination-btn.active:hover {
    background: #2563eb !important;
  }

  /* Estados disabled */
  .pagination-btn.disabled,
  .pagination-btn:disabled {
    opacity: 0.4 !important;
    cursor: not-allowed !important;
    background: #f1f5f9 !important;
    color: #94a3b8 !important;
  }

  .pagination-btn.disabled:hover,
  .pagination-btn:disabled:hover {
    background: #f1f5f9 !important;
    opacity: 0.4 !important;
  }

  /* Estados focus para accesibilidad */
  .pagination-btn:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* Botones de navegación específicos */
  .pagination-first,
  .pagination-last,
  .pagination-prev,
  .pagination-next {
    background: #f1f5f9 !important;
    color: #64748b !important;
    min-width: 36px !important;
  }

  .pagination-first:hover:not(.disabled),
  .pagination-last:hover:not(.disabled),
  .pagination-prev:hover:not(.disabled),
  .pagination-next:hover:not(.disabled) {
    background: #e2e8f0 !important;
    color: #475569 !important;
  }

  /* Ellipsis */
  .pagination-ellipsis {
    padding: 0.5rem 0.75rem;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 500;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    min-width: 36px;
    min-height: 36px;
  }

  /* Información de paginación */
  .pagination-info {
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 500;
    background: transparent;
    padding: 0.5rem 0;
    white-space: nowrap;
  }

  /* Responsive design */

  @media (max-width: 768px) {
    .pagination-container {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .pagination {
      justify-content: center;
      padding: 0.375rem;
      gap: 0.25rem;
      flex-wrap: wrap;
    }

    .pagination-btn {
      padding: 0.5rem 0.625rem;
      min-width: 36px;
      font-size: 0.8rem;
    }

    .pagination-number {
      min-width: 36px;
    }

    /* Ocultar botones de primera/última página en móvil */
    .pagination-first,
    .pagination-last {
      display: none;
    }

    .pagination-info {
      text-align: center;
      font-size: 0.8rem;
      padding: 0.5rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .pagination {
      gap: 0.125rem;
      padding: 0.25rem;
    }

    .pagination-btn {
      padding: 0.375rem 0.5rem;
      min-width: 32px;
      font-size: 0.75rem;
    }

    .pagination-number {
      min-width: 32px;
    }

    .pagination-ellipsis {
      padding: 0.375rem 0.25rem;
      font-size: 0.875rem;
    }

    /* En pantallas muy pequeñas, mostrar menos números de página */
    .pagination-container {
      margin-top: 1.5rem;
      padding-top: 1rem;
    }

    .pagination-info {
      font-size: 0.75rem;
      order: 2;
    }

    .pagination {
      order: 1;
    }
  }

  @media (max-width: 360px) {
    .pagination-btn {
      padding: 0.25rem 0.375rem;
      min-width: 28px;
    }

    .pagination-number {
      min-width: 28px;
    }
  }
</style>

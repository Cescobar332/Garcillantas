---
interface Props {
  imageUrl: string;
}

const { imageUrl } = Astro.props;
---

<div class="bg-container">
  <div class="bg-image"></div>
  <div class="overlay"></div>
  <div class="vintage-effect"></div>
  <div class="scanlines"></div>
</div>

<style define:vars={{ imageUrl: `url('${imageUrl}')` }}>
  .bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: -1;
    overflow: hidden;
  }

  .bg-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 110%;
    height: 110%;
    background-image: var(--imageUrl);
    background-size: cover;
    background-position: center;
    transform: translate(-50%, -50%);
    animation: moveBackground 20s ease-in-out infinite alternate;
  }

  @keyframes moveBackground {
    0% {
      transform: translate(-50%, -50%) scale(1.1);
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #00000077;
    background-size: 100% 100%;
    background-position: 0px 0px,0px 0px,0px 0px;
    background-image: radial-gradient(100% 37% at 51% 4%, #0D4BA0 47%, #073AFF00 100%),
                      radial-gradient(100% 37% at 47% 103%, #FFDD00 47%, #073AFF00 100%),
                      radial-gradient(75% 75% at 50% 50%, rgb(1, 11, 24) 0%, #0D4BA0 99%);
    opacity: 0.85;
    /* mix-blend-mode: overlay; */
  }

  .vintage-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('data:image/svg+xml;base64,');
    pointer-events: none;
    animation: grain 4s steps(8) infinite;
    mix-blend-mode: overlay;
    opacity: 0.35;
    filter: contrast(120%) brightness(var(--flicker));
  }

  .scanlines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 0.5%,
      transparent 1%
    );
    pointer-events: none;
    animation: scanlines 4s linear infinite;
    opacity: 0.8;
  }

  @keyframes grain {
    0%, 100% { transform: translate(0, 0) }
    10% { transform: translate(-8%, -8%) }
    20% { transform: translate(-15%, 5%) }
    30% { transform: translate(8%, -15%) }
    40% { transform: translate(-8%, 20%) }
    50% { transform: translate(-15%, 8%) }
    60% { transform: translate(20%, 0%) }
    70% { transform: translate(0%, 15%) }
    80% { transform: translate(5%, 35%) }
    90% { transform: translate(-15%, 15%) }
  }

  @keyframes scanlines {
    from { background-position: 0 0 }
    to { background-position: 0 300% }
  }

  @keyframes flicker {
    0%, 100% { --flicker: 100%; }
    5% { --flicker: 95%; }
    10% { --flicker: 105%; }
    15% { --flicker: 95%; }
    20% { --flicker: 100%; }
    25% { --flicker: 105%; }
    30% { --flicker: 95%; }
    35% { --flicker: 100%; }
    40% { --flicker: 105%; }
  }

  @media (max-width: 768px) {
    .bg-image {
      width: 120%;
      height: 120%;
    }
  }
</style>
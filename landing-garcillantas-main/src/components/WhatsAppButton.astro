---
const locations = {
  santander: "573174406744",
  caribe: "573175100134"
};
const defaultMessage = "¡Hola! Me gustaría obtener más información sobre sus servicios.";
---

<div class="whatsapp-button">
  <button class="whatsapp-icon" aria-label="Abrir chat de WhatsApp" id="whatsappToggle">
    <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="currentColor" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </button>

  <div class="chat-popup" id="chatPopup">
    <div class="chat-header">
      <h3>WhatsApp Chat</h3>
      <button class="close-button" id="closeChat" aria-label="Cerrar chat">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="chat-body">
      <select id="locationSelect" class="location-select">
        <option value="santander">Sede Santander</option>
        <option value="caribe">Sede Caribe</option>
      </select>
      <textarea 
        id="whatsappMessage" 
        placeholder="Escribe tu mensaje aquí..."
        rows="4"
      >{defaultMessage}</textarea>
      <button class="send-button" id="sendWhatsApp">
        Enviar mensaje
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .whatsapp-button {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 1000;
  }

  .whatsapp-icon {
    background: #25D366;
    border: none;
    border-radius: 50%;
    padding: 1rem;
    color: white;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease;
  }

  .whatsapp-icon:hover {
    transform: scale(1.1);
  }

  .chat-popup {
    position: absolute;
    bottom: calc(100% + 1rem);
    left: 0;
    width: 300px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.2);
    transform: scale(0);
    opacity: 0;
    transform-origin: bottom left;
    transition: all 0.3s ease;
  }

  .chat-popup.active {
    transform: scale(1);
    opacity: 1;
  }

  .chat-header {
    background: #25D366;
    color: white;
    padding: 1rem;
    border-radius: 12px 12px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .close-button {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.25rem;
  }

  .chat-body {
    padding: 1rem;
  }

  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 0.75rem;
    margin-bottom: 1rem;
    resize: none;
    font-family: inherit;
  }

  .send-button {
    width: 100%;
    background: #25D366;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background-color 0.3s ease;
  }

  .send-button:hover {
    background: #1ea952;
  }

  .location-select {
    width: 100%;
    margin-bottom: 1rem;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-family: inherit;
    background-color: white;
  }

  @media (max-width: 480px) {
    .chat-popup {
      width: 280px;
      left: -2rem;
    }
  }
</style>

<script>
  const locations = {
    santander: "573174406744",
    caribe: "573175100134"
  };

  document.addEventListener('DOMContentLoaded', function() {
    const whatsappToggle = document.getElementById('whatsappToggle');
    const chatPopup = document.getElementById('chatPopup');
    const closeChat = document.getElementById('closeChat');
    const sendWhatsApp = document.getElementById('sendWhatsApp');
    const messageInput = document.getElementById('whatsappMessage');
    const locationSelect = document.getElementById('locationSelect');

    whatsappToggle?.addEventListener('click', () => {
      chatPopup?.classList.toggle('active');
    });

    closeChat?.addEventListener('click', () => {
      chatPopup?.classList.remove('active');
    });

    sendWhatsApp?.addEventListener('click', () => {
      const selectedLocation = (locationSelect as HTMLSelectElement)?.value || 'santander';
      const phoneNumber = locations[selectedLocation as keyof typeof locations];
      const message = encodeURIComponent(messageInput?.value || '');
      window.open(`https://wa.me/${phoneNumber}?text=${message}`, '_blank');
    });
  });
</script>
<style>
  .footer {
    background: var(--primary-color);
    color: white;
    padding: var(--spacing-lg) 0 var(--spacing-sm);
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
  }

  .footer-section h3 {
    color: var(--secondary-color);
    margin-bottom: var(--spacing-md);
    font-size: 1.5rem;
    padding: 0.5em 0;
    border-bottom:  1px solid rgba(255, 255, 255, 0.1);
    font-weight: bold;
    font-family: var(--font-family-display);
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-section li {
    margin-bottom: var(--spacing-sm);
  }

  .footer-section a {
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .social-icon {
    background: rgba(255, 255, 255, 0.1);
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .social-icon svg {
    width: 24px;
    height: 24px;
  }

  .social-icon:hover {
    background: var(--secondary-color);
  }

  .social-icon:hover svg {
    color: var(--primary-color);
  }

  .footer-section a:hover {
    color: var(--secondary-color);
    transform: translateY(-3px);
  }

  svg {
    min-width: 24px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    max-width: var(--max-width);
    justify-content: space-between;
    text-align: center;
    margin: 0 auto;
    margin-top: var(--spacing-lg);
    padding: var(--spacing-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-bottom a {
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
      text-align: center;
      justify-content: center;
    }
    .footer-bottom{
      justify-content: center;
    }

    .footer-section {
      margin-bottom: var(--spacing-md);
    }
  }
</style>
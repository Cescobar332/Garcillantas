---
interface Props {
  type?: 'products' | 'filters' | 'search' | 'page';
  message?: string;
  showSkeleton?: boolean;
  itemCount?: number;
  className?: string;
}

const { 
  type = 'products',
  message,
  showSkeleton = true,
  itemCount = 6,
  className = ''
} = Astro.props;

const messages = {
  products: message || 'Cargando productos...',
  filters: message || 'Cargando filtros...',
  search: message || 'Buscando productos...',
  page: message || 'Cargando página...'
};
---

<div class={`loading-state loading-${type} ${className}`} id="loading-state">
  {showSkeleton && type === 'products' && (
    <div class="skeleton-grid">
      {Array.from({ length: itemCount }, (_, index) => (
        <div class="skeleton-card" key={index}>
          <div class="skeleton-image"></div>
          <div class="skeleton-content">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-subtitle"></div>
            <div class="skeleton-line skeleton-text"></div>
            <div class="skeleton-specs">
              <div class="skeleton-spec"></div>
              <div class="skeleton-spec"></div>
              <div class="skeleton-spec"></div>
            </div>
            <div class="skeleton-price"></div>
          </div>
        </div>
      ))}
    </div>
  )}

  {showSkeleton && type === 'filters' && (
    <div class="skeleton-filters">
      <div class="skeleton-filter-header"></div>
      {Array.from({ length: 5 }, (_, index) => (
        <div class="skeleton-filter-group" key={index}>
          <div class="skeleton-filter-label"></div>
          <div class="skeleton-filter-input"></div>
        </div>
      ))}
    </div>
  )}

  {!showSkeleton && (
    <div class="loading-content">
      <div class="loading-spinner">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
      </div>
      <p class="loading-message">{messages[type]}</p>
      <div class="loading-progress">
        <div class="progress-bar"></div>
      </div>
    </div>
  )}
</div>

<script>
class LoadingState {
  constructor() {
    this.loadingState = document.getElementById('loading-state');
    this.progressBar = document.querySelector('.progress-bar');
    this.loadingMessage = document.querySelector('.loading-message');
    
    this.currentProgress = 0;
    this.progressInterval = null;
    
    this.init();
  }

  init() {
    this.startProgressAnimation();
    this.setupIntersectionObserver();
  }

  startProgressAnimation() {
    if (!this.progressBar) return;
    
    this.progressInterval = setInterval(() => {
      this.currentProgress += Math.random() * 15;
      if (this.currentProgress > 90) {
        this.currentProgress = 90;
        clearInterval(this.progressInterval);
      }
      this.progressBar.style.width = `${this.currentProgress}%`;
    }, 200);
  }

  completeProgress() {
    if (this.progressBar) {
      this.currentProgress = 100;
      this.progressBar.style.width = '100%';
      clearInterval(this.progressInterval);
    }
  }

  setupIntersectionObserver() {
    const skeletonCards = document.querySelectorAll('.skeleton-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('animate');
          }, index * 100);
        }
      });
    }, {
      threshold: 0.1
    });

    skeletonCards.forEach(card => observer.observe(card));
  }

  updateMessage(message) {
    if (this.loadingMessage) {
      this.loadingMessage.textContent = message;
    }
  }

  show(type = 'products', message = null) {
    if (this.loadingState) {
      this.loadingState.className = `loading-state loading-${type}`;
      this.loadingState.style.display = 'block';
      
      if (message && this.loadingMessage) {
        this.updateMessage(message);
      }
      
      this.currentProgress = 0;
      this.startProgressAnimation();
    }
  }

  hide() {
    if (this.loadingState) {
      this.completeProgress();
      
      setTimeout(() => {
        this.loadingState.style.display = 'none';
        clearInterval(this.progressInterval);
      }, 300);
    }
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  window.loadingState = new LoadingState();
});
</script>

<style>
  .loading-state {
    width: 100%;
    padding: 2rem 0;
  }

  /* Skeleton Grid */
  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skeleton-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
  }

  .skeleton-card.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .skeleton-image {
    width: 100%;
    height: 200px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skeleton-line {
    height: 16px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    border-radius: 8px;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-title {
    height: 20px;
    width: 80%;
  }

  .skeleton-subtitle {
    height: 16px;
    width: 60%;
  }

  .skeleton-text {
    height: 14px;
    width: 90%;
  }

  .skeleton-specs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .skeleton-spec {
    width: 60px;
    height: 24px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    border-radius: 12px;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-price {
    height: 24px;
    width: 40%;
    background: linear-gradient(90deg, #e3f2fd 25%, #bbdefb 50%, #e3f2fd 75%);
    background-size: 200% 100%;
    border-radius: 12px;
    animation: shimmer 1.5s infinite;
  }

  /* Skeleton Filters */
  .skeleton-filters {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .skeleton-filter-header {
    height: 24px;
    width: 60%;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-filter-group {
    margin-bottom: 1rem;
  }

  .skeleton-filter-label {
    height: 16px;
    width: 40%;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-filter-input {
    height: 40px;
    width: 100%;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    border-radius: 8px;
    animation: shimmer 1.5s infinite;
  }

  /* Loading Content */
  .loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    text-align: center;
    gap: 1.5rem;
  }

  .loading-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, rgba(13, 75, 160, 0.1) 0%, rgba(30, 64, 175, 0.05) 100%);
    border-radius: 50%;
    color: var(--primary-color);
  }

  .loading-spinner svg {
    animation: spin 1s linear infinite;
  }

  .loading-message {
    font-size: 1.125rem;
    font-weight: 500;
    color: #374151;
    margin: 0;
  }

  .loading-progress {
    width: 200px;
    height: 4px;
    background: #e5e7eb;
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-color) 0%, #1e40af 100%);
    border-radius: 2px;
    width: 0%;
    transition: width 0.3s ease;
  }

  /* Animations */
  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .skeleton-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }

    .skeleton-content {
      padding: 1rem;
    }

    .loading-content {
      min-height: 200px;
      gap: 1rem;
    }

    .loading-spinner {
      width: 60px;
      height: 60px;
    }

    .loading-spinner svg {
      width: 36px;
      height: 36px;
    }

    .loading-message {
      font-size: 1rem;
    }

    .loading-progress {
      width: 150px;
    }
  }

  @media (max-width: 480px) {
    .skeleton-grid {
      grid-template-columns: 1fr;
    }

    .loading-state {
      padding: 1rem 0;
    }

    .skeleton-filters {
      padding: 1rem;
    }
  }

  /* Type-specific styles */
  .loading-search .loading-spinner {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(22, 163, 74, 0.05) 100%);
    color: #22c55e;
  }

  .loading-filters .skeleton-filter-group:nth-child(odd) .skeleton-filter-input {
    animation-delay: 0.2s;
  }

  .loading-filters .skeleton-filter-group:nth-child(even) .skeleton-filter-label {
    animation-delay: 0.1s;
  }

  /* Enhanced skeleton animations */
  .skeleton-card:nth-child(1) { animation-delay: 0ms; }
  .skeleton-card:nth-child(2) { animation-delay: 100ms; }
  .skeleton-card:nth-child(3) { animation-delay: 200ms; }
  .skeleton-card:nth-child(4) { animation-delay: 300ms; }
  .skeleton-card:nth-child(5) { animation-delay: 400ms; }
  .skeleton-card:nth-child(6) { animation-delay: 500ms; }
</style>

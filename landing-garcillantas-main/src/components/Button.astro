---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  icon?: string;
  iconPosition?: 'left' | 'right';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  onClick?: string;
}

import Icon from './Icon.astro';

const {
  href,
  variant = 'primary',
  icon,
  iconPosition = 'right',
  class: className,
  type = 'button',
  onClick,
  ...rest
} = Astro.props;

const Element = href ? 'a' : 'button';
const elementProps = href ? { href } : { type, onClick };
---

<Element
  {...elementProps}
  {...rest}
  class:list={[
    'button',
    `button--${variant}`,
    icon && 'button--with-icon',
    icon && `button--icon-${iconPosition}`,
    className
  ]}
>
  {icon && iconPosition === 'left' && <Icon name={icon} />}
  <slot />
  {icon && iconPosition === 'right' && <Icon name={icon} />}
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: bold;
    transition: all 0.3s ease;
    cursor: pointer;
    padding: 1em;
    border-radius: 8px;
    border: none;
    font-family: inherit;
    font-size: inherit;
    text-align: center;
    justify-content: center;
  }

  .button:focus {
    outline: 2px solid var(--secondary-color);
    outline-offset: 2px;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button--primary {
    background: var(--primary-color);
    color: #ffffff;
  }

  .button--primary:hover {
    background: var(--primary-color-dark, #0a3b80);
    color: var(--secondary-color);
  }

  .button--secondary {
    background: transparent;
    color: var(--secondary-color);
    border: 1px solid var(--secondary-color);
  }

  .button--secondary:hover {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--secondary-color);
  }

  .button--with-icon {
    padding-right: 1.5em;
    padding-left: 1.5em;
  }

  .button--with-icon :global(svg) {
    width: 1.2em;
    height: 1.2em;
    transition: transform 0.3s ease;
  }

  .button--icon-right:hover :global(svg) {
    transform: translateX(4px);
  }

  .button--icon-left:hover :global(svg) {
    transform: translateX(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button--with-icon :global(svg) {
      transition: none;
    }

    .button:hover :global(svg) {
      transform: none;
    }
  }
</style>
---
interface Props {
  position?: 'left' | 'right';
  text?: string;
  message?: string;
  icon?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  popupId?: string;
}

const { 
  position = 'left',
  text = 'Contactar un asesor',
  message = '',
  icon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>',
  variant = 'primary',
  popupId = crypto.randomUUID()
} = Astro.props;

const messageParam = message ? `?text=${encodeURIComponent(message)}` : '';
---

<div class="whatsapp-container">
  <button class={`whatsapp-btn whatsapp-trigger ${variant}`} data-popup-id={popupId}>
    {position === 'left' && <span set:html={icon} />}
    <span>{text}</span>
    {position === 'right' && <span set:html={icon} />}
  </button>
</div>

<div class="popup whatsapp-popup" id={popupId}>
  <div class="popup-content">
    <button class="close-btn whatsapp-close">×</button>
    <h3>Seleccione una sede</h3>
    <div class="popup-buttons">
      <a href={`https://wa.me/573174406744${messageParam}`} target="_blank" class="whatsapp-option">
          <span set:html={icon} />
        Sedes Santander
      </a>
      <a href={`https://wa.me/573175100134${messageParam}`} target="_blank" class="whatsapp-option">
          <span set:html={icon} />
        Sedes Caribe
      </a>
    </div>
  </div>
</div>

<style>
  .whatsapp-container {
    position: relative;
  }

  .whatsapp-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 1em 2em;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    font-size: 1em;
    transition: all 0.3s;
    text-align: center;
    text-decoration: none;
  }

  .whatsapp-btn.primary {
    background-color: var(--primary-color);
    color: white;
    border: none;
  }

  .whatsapp-btn.secondary {
    background-color: var(--secondary-color);
    color: var(--primary-color);
    border: none;
  }

  .whatsapp-btn.outline {
    background-color: transparent;
    color: var(--secondary-color);
    border: 2px solid var(--secondary-color);
  }

  .whatsapp-btn.primary:hover {
    background-color: var(--primary-color);
    color: var(--secondary-color);
  }

  .whatsapp-btn.secondary:hover {
    background-color: var(--primary-color);
    color: var(--secondary-color);
  }

  .whatsapp-btn.outline:hover {
    background-color: var(--primary-color);
    color: var(--secondary-color);
    border-color: var(--primary-color);
  }

  .popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(5px);
    z-index: 10000;
  }

    .popup-content {
        position: relative;
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        max-width: 400px;
        margin: 20% auto;
    }

    .popup-content h3 {
        margin: 0;
        font-size: 1.5em;
        text-align: center;
        color: var(--primary-color);
    }

  .close-btn {
    position: absolute;
    right: 10px;
    top: 10px;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--primary-color);
    cursor: pointer;
  }

  .popup-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }

  .whatsapp-option {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color:var(--primary-color);
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    font-weight: bold;
    border-radius: 5px;
    transition: background-color 0.3s;
  }

  .whatsapp-option:hover {
    background-color: var(--secondary-color);
    color: var(--primary-color);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(event) {
        // Delegación de eventos para el botón de apertura
        const trigger = event.target.closest('.whatsapp-trigger');
        if (trigger) {
            const popupId = trigger.dataset.popupId;
            const popup = document.getElementById(popupId);
            if (popup) {
                popup.style.display = 'block';
            }
        }

        // Delegación de eventos para el botón de cierre
        if (event.target.closest('.whatsapp-close')) {
            const popup = event.target.closest('.whatsapp-popup');
            popup.style.display = 'none';
        }

        // Cierre al hacer clic fuera del contenido
        if (event.target.classList.contains('whatsapp-popup')) {
            event.target.style.display = 'none';
        }
    });

    // Cierre con tecla Escape
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            document.querySelectorAll('.whatsapp-popup').forEach(popup => {
                popup.style.display = 'none';
            });
        }
    });
});
</script>

---
import service from '@astrojs/vercel/build-image-service';
import Button from './Button.astro';
import BGVideo from './BGVideo.astro';

interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title = "Expertos en Llantas y Servicios Automotrices",
  description = "Brindamos soluciones integrales para el mantenimiento de tu vehículo con la más alta calidad y tecnología de punta.",
  ctaText = "Conoce Nuestros Servicios",
  ctaLink = "#servicios"
} = Astro.props;
---

<section class="hero">
  <BGVideo />
  <div class="hero-container">
    <div class="hero-content">
      <h1>{title}</h1>
      <p>{description}</p>
        <Button 
          href={ctaLink} 
          variant="primary" 
          icon="right-arrow"
        >
        {ctaText}
        </Button>
    </div>
    <div class="hero-image">
      <img src="/images/trace.webp" alt="huella de llanta" title="Huella de llanta" class="trace" />
      <img src="/images/tire.webp" alt="Servicios automotrices profesionales"  title="Servicios automotrices profesionale "/>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding: 2rem 0;
    margin: 5rem 0;
  }

  .hero-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .hero-content {
    padding-right: var(--spacing-lg);
    animation: slideInLeft 1s ease-out;
    text-align: left;
  }

  .hero-image {
    position: relative;
    z-index: 1;
    animation: slideInRight 1s ease-out;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-100px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(100px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes rotate {
    0% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(180deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes float {
    0% {
      transform: translate(0, 0) rotate(45deg);
    }
    50% {
      transform: translate(0, 20px) rotate(45deg);
    }
    100% {
      transform: translate(0, 0) rotate(45deg);
    }
  }

  .hero-content h1 {
    font-size: 3.5rem;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    color: var(--secondary-color);
    text-wrap: pretty;
    font-family: var(--font-family-display);
  }

  .hero-content p {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
    color: white;
    opacity: 0.9;
    font-weight: 200;
    text-wrap: pretty;
  }

  .hero-image {
    position: relative;
    z-index: 1;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    position: relative;
    z-index: 2;
    animation: rotate 3s ease-in-out infinite;
  }

  .hero-image .trace{
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.5;
    animation-play-state: paused;
  }


  .geometric-shapes {
    position: absolute;
    inset: -20px;
    z-index: 1;
  }

  .shape {
    position: absolute;
    opacity: 0.5;
    background: var(--primary-color);
    border-radius: 50%;
    padding: 1em;
    animation: rotate 3s ease-in-out infinite;
  }

  .shape .element{
    fill: var(--secondary-color);
    color: var(--secondary-color);
  }

  .shape-1 {
    width: 100px;
    height: 100px;
    top: -30px;
    right: 50px;
    transform: rotate(45deg);
    animation-delay: 0s;
  }

  .shape-2 {
    width: 120px;
    height: 120px;
    bottom: -10px;
    left: 0px;
    transform: rotate(30deg);
    animation-delay: 2s;
  }

  .shape-3 {
    width: 90px;
    height: 90px;
    bottom: 5%;
    right: 0px;
    transform: rotate(60deg);
    animation-delay: 3s;
  }

  @media (max-width: 968px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      padding-right: 0;
      order: 0;
      text-align: center;
    }

    .hero-image {
      order: 1;
    }

    .hero-content h1 {
      font-size: 2.5rem;
      text-align: center;
    }

    .hero-content p {
      font-size: 1.1rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hero-container{
        text-align: center;
    }
    .hero-content h1 {
      font-size: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-image,
    .shape {
      animation: none;
    }
  }
</style>
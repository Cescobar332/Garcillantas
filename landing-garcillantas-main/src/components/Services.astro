---
import Image from './Image.astro';
import Button from './Button.astro';
import WhatsAppBtnPopup from './WhatsAppBtnPopup.astro';
import { getAllServices } from '../lib/contentful';

const services = await getAllServices();
const formattedServices = services.sort((a, b) => a.fields.serviceOrder - b.fields.serviceOrder).map(service => 
({
    id: service.fields.slug,
    title: service.fields.title,
    description: service.fields.shortDescription,
    icon: service.fields.icon?.[0] || 'service-wrench'
}));

---

<section class="services-section" id="servicios">
  <video class="background-video" autoplay loop muted playsinline>
    <source src="/videos/fondobga.mp4" type="video/mp4">
  </video>
  <div class="overlay"></div>
  
  <div class="services-container">
    <h2>Nuestros Servicios</h2>
    <p class="subtitle">Expertos en el cuidado de tu vehículo</p>
    
    <div class="services-grid">
      {formattedServices.map(service => (
        <div class="service-card">
          <div class="icon-wrapper">
            <a href={`/servicios/${service.id}`}>
              <Image name={service.icon} size={200} priority={true}/>
            </a>
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <div class="service-actions">
            <Button 
              href={`/servicios/${service.id}`} 
              variant="primary" 
              icon="right-arrow"
            >
              Ver Detalles
            </Button>
            <WhatsAppBtnPopup
              variant='outline'
              text='Solicitar Servicio'
              message={`Hola, me interesa el servicio de ${service.title}`}
            />
          </div>
        </div>
      ))}
      <div class="service-card">
        <div class="icon-wrapper">
          <a href={`/llantas`}>
            <Image name="wheel" size={200} priority={true}/>
          </a>
        </div>
        <h3>Llantas</h3>
        <p>Contamos con una amplia variedad de llantas para todo tipo de veh&iacute;culo, desde autom&oacute;viles hasta camiones y maquinaria pesada, de las mejores marcas y con caracter&iacute;sticas especiales para cada necesidad.</p>
        <div class="service-actions">
          <Button 
            href={`/llantas`} 
            variant="primary" 
            icon="right-arrow"
          >
            Ver Detalles
          </Button>
          <WhatsAppBtnPopup
            variant='outline'
            text='Solicitar Servicio'
            message={`Hola,%20me%20interesa%20el%20servicio%20de%20llantas`}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initializeServiceCards() {
    const cards = document.querySelectorAll('.service-card');
    if (!cards.length) return;

    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });

      card.addEventListener('mouseleave', () => {
        card.style.setProperty('--mouse-x', '0px');
        card.style.setProperty('--mouse-y', '0px');
      });
    });
  }

  // Inicializar cuando el DOM está listo
  document.addEventListener('DOMContentLoaded', initializeServiceCards);

  // Reinicializar después de las transiciones de vista
  document.addEventListener('astro:page-load', initializeServiceCards);
</script>

<style>
  .services-section {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 3em 0;
  }

  .background-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    background-position: 0px 0px;
    background-image: radial-gradient(75% 75% at 50% 50%, #0d4aa0af 50%, #0d4aa0 100%);
    z-index: 1;
  }

  .services-container {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }

  h2 {
    text-align: center;
    color: var(--secondary-color);
    font-family: var(--font-family-display);
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    text-align: center;
    color: white;
    font-size: 1.2rem;
    margin-bottom: 4rem;
    opacity: 0.9;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    box-sizing: border-box;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      800px circle at var(--mouse-x) var(--mouse-y),
      rgba(255, 221, 0, 0.554),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 1;
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card > * {
    position: relative;
    z-index: 2;
  }
  .service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .icon-wrapper {
    margin: 0 auto 1.5rem;
    background: radial-gradient(75% 75% at 50% 50%, #ffffff 30%, var(--secondary-color) 100%);
    border: 20px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--secondary-color);
    position: relative;
    transition: transform 0.3s ease;
    box-sizing: border-box;
    aspect-ratio: 1/1;
    padding: 2rem;
  }

  .icon-wrapper::before {
    content: '';
    position: absolute;
    top: -25px;
    left: -25px;
    right: -25px;
    bottom: -25px;
    border: 25px solid var(--primary-color);
    border-radius: 50%;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5);
  }

  .icon-wrapper::after {
    content: '';
    position: absolute;
    inset: -18px;
    border: 10px dashed rgba(255, 255, 255, 0.2);
    border-radius: 50%;
  }

  .icon-wrapper  a{
    position: relative;
    z-index: 2;
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .service-card:hover .icon-wrapper {
    animation: rotate 10s linear infinite;
  }

  @keyframes counter-rotate {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  .service-card:hover .icon-wrapper a {
    animation: counter-rotate 10s linear infinite;
  }

  .service-card h3 {
    color: var(--secondary-color);
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-family-display);
  }

  .service-card p {
    color: white;
    opacity: 0.9;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .service-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  @media (max-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    }
    .services-container {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 2.5rem;
    }

    .services-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }

    .service-card {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transform: none;
    }
    
    .service-card:hover {
      transform: none;
    }
  }
</style>
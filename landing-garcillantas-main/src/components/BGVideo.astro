---
---

<div class="video-background">
  <video autoplay muted loop playsinline>
    <source src="/videos/background.mp4" type="video/mp4">
    <source src="/videos/background.webm" type="video/webm">
  </video>
  <div class="overlay"></div>
</div>

<style>
  .video-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #00000077;
    background-size: 100% 100%;
background-position: 0px 0px,0px 0px,0px 0px;
background-image: radial-gradient(100% 37% at 51% 4%, #0D4BA0 47%, #073AFF00 100%),radial-gradient(100% 37% at 47% 103%, #FFDD00 47%, #073AFF00 100%),radial-gradient(75% 75% at 50% 50%, rgb(1, 11, 24) 0%, #0D4BA0 99%);
    opacity: 0.85;
  }
</style>
---
import { getAllServiceStations, type ServiceStation } from "../lib/contentful";

const allStations = (await getAllServiceStations()) as ServiceStation[];

// Agrupar por región
const santanderStations: ServiceStation[] = allStations.filter(
  (s: ServiceStation) => Array.isArray(s.fields.region) && s.fields.region.includes("Santander")
);
const caribeStations: ServiceStation[] = allStations.filter(
  (s: ServiceStation) => Array.isArray(s.fields.region) && s.fields.region.includes("Caribe")
);
---

<section class="stations-section" id="servitecas">
  <!-- Add decorative shapes -->
  <div class="decorative-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
  </div>
  
  <div class="stations-container">
    <h1>Red de Servitecas Garcillantas</h1>
    <p class="subtitle">Encuentra la sede más cercana a ti</p>
    
    <h2>Sedes Santander</h2>
    <div class="stations-grid">
      {santanderStations.map((station) => (
        <a href={`/servitecas/${station.fields.slug}`} class="station-card-link">
          <div class="station-card">
            <div class="station-image">
              <img src={station.fields.image?.fields.file.url} alt={`Serviteca ${station.fields.name}`} />
            </div>
            <div class="station-info">
              <h3>{station.fields.name}</h3>
              <p class="address">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {station.fields.address}
              </p>
              {station.fields.phone && (
                <p class="phone">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                  Tel: {station.fields.phone}{station.fields.ext ? ` Ext: ${station.fields.ext}` : ""}
                </p>
              )}
              {station.fields.mobile && (
                <p class="mobile">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12" y2="18"></line>
                  </svg>
                  Cel: {station.fields.mobile}
                </p>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>

    <h2>Sedes Caribe</h2>
    <div class="stations-grid">
      {caribeStations.map((station) => (
        <a href={`/servitecas/${station.fields.slug}`} class="station-card-link">
          <div class="station-card">
            <div class="station-image">
              <img src={station.fields.image?.fields.file.url} alt={`Serviteca ${station.fields.name}`} />
            </div>
            <div class="station-info">
              <h3>{station.fields.name}</h3>
              <p class="address">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {station.fields.address}
              </p>
              {station.fields.mobile && (
                <p class="mobile">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12" y2="18"></line>
                  </svg>
                  Cel: {station.fields.mobile}
                </p>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .stations-section {
    padding: 4rem 0;
    width: 100%;
    justify-content: center;
    background: #ffdd00a2;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .decorative-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    opacity: 0.1;
    background: var(--primary-color);
  }

  .shape-1 {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    top: -150px;
    left: -150px;
    animation: float 8s ease-in-out infinite;
  }

  .shape-2 {
    width: 200px;
    height: 200px;
    transform: rotate(45deg);
    bottom: -100px;
    right: -100px;
    animation: float 6s ease-in-out infinite;
    animation-delay: 1s;
  }

  .shape-3 {
    width: 150px;
    height: 150px;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    top: 50%;
    right: 50px;
    animation: float 7s ease-in-out infinite;
    animation-delay: 2s;
  }

  .shape-4 {
    width: 100px;
    height: 100px;
    border-radius: 63% 37% 37% 63% / 43% 37% 63% 57%;
    bottom: 100px;
    left: 50px;
    animation: float 5s ease-in-out infinite;
    animation-delay: 3s;
  }

  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  /* Add media query for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .shape {
      animation: none;
    }
  }

  .stations-container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h1 {
    text-align: center;
    color: var(--primary-color);
    font-size: 3.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-family-display);
  }
  h2 {
    text-align: center;
    color: var(--primary-color);
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-family-display);
  }

  .subtitle {
    text-align: center;
    color: var(--primary-color);
    font-size: 1.2rem;
    margin-bottom: 3rem;
    opacity: 0.8;
  }

  .stations-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    padding: 1rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .station-card {
    background: var(--primary-color);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .station-card:hover {
    transform: translateY(-5px);
  }

  .station-image {
    width: 100%;
    height: 300px;
    overflow: hidden;
  }

  .station-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .station-card:hover .station-image img {
    transform: scale(1.1);
  }

  .station-info {
    padding: 1.5rem;
  }

  .station-info h3 {
    color: var(--secondary-color);
    font-size: 1.5rem;
    margin: 0 0 1.5rem 0;
    font-family: var(--font-family-display);
  }

  .station-info p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }

  .station-info svg {
    width: 18px;
    height: 18px;
    color: var(--secondary-color);
  }

  @media (max-width: 768px) {
    .stations-grid {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    }

    h2 {
      font-size: 2rem;
    }
  }
  @media (min-width: 968px) {
    .stations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stations-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media (max-width: 480px) {
    .station-card {
      margin: 0 auto;
      max-width: 100%;
    }

    .stations-section {
      padding: var(--spacing-lg) var(--spacing-sm);
    }
  }
</style>